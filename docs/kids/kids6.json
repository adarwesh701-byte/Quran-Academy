un","head","🙂"],["شَعْرٌ","sha3run","hair","💇"],["أُذُنٌ","udhunun","ear","👂"],["عَيْنٌ","3aynun","eye","👁️"],["أَنْفٌ","anfun","nose","👃"],["فَمٌ","famun","mouth","👄"],["رَقَبَةٌ","raqabatun","neck","🦒"],["يَدٌ","yadun","hand","✋"],["صَدْرٌ","Sadrun","chest","🫁"],["رِجْلٌ","rijlun","leg","🦵"]],[["لقلق","مَنْ هَؤُلَاءِ؟","man ha2ulaa2i?","Who are these?"],["شميم","هَؤُلَاءِ أَصْدِقَائِي الْخَمْسَةُ. أُذُنُ فُوفُو طَوِيلَةٌ.","ha2ulaa2i aSdiqaa2ii alkhamsatu. udhunu fuufuu Tawiilatun.","These are my five friends. Fufu's ear is long."],["لقلق","عَرَفْتُ فُوفُو.","3araftu fuufuu.","I know Fufu."],["شميم","رِيرِي لَهُ عَيْنٌ وَاحِدَةٌ، وَرَقَبَةٌ قَصِيرَةٌ.","riirii lahu 3aynun waa7idatun, waraqabatun qaSiiratun.","Riri has one eye and a short neck."],["لقلق","عَرَفْتُهُ، عَيْنُهُ مِثْلُ الشَّمْسِ.","3araftuhu, 3aynuhu mithlu ash-shamsi.","I know him — his eye is like the sun."],["شميم","لُولُو رَأْسُهُ كَبِيرٌ وَشَعْرُهُ طَوِيلٌ.","luuluu ra2asuhu kabiirun washa3ruhu Tawiilun.","Lulu's head is big and his hair is long."],["لقلق","عَرَفْتُهُ.","3araftuhu.","I know him."],["شميم","تِيتِي لَهُ رِجْلٌ طَوِيلَةٌ، وَيَدٌ قَصِيرَةٌ.","tiitii lahu rijlun Tawiilatun, wayadun qaSiiratun.","Titi has a long leg and a short hand."],["لقلق","عَرَفْتُهُ.","3araftuhu.","I know him."],["شميم","شَرْشَرٌ صَدْرُهُ كَبِيرٌ، وَأَنْفُهُ صَغِيرٌ.","sharsharun Sadruhu kabiirun, wa2anfuhu Saghiirun.","Sharshar's chest is big and his nose is small."],["لقلق","عَرَفْتُهُ.","3araftuhu.","I know him."],["شميم","وَأَنَا هُنَا فَمِي صَغِيرٌ.","wa2anaa hunaa famii Saghiirun.","And me — my mouth is small."],["لقلق","لَا أَعْرِفُكَ!","laa a3rifuka!","I don't know you!"]],["أجزاء الجسم. الضمير المتصل: رَأْسُهُ (بتاعه)، فَمِي (بتاعي)، أَعْرِفُكَ (أعرفك). «هَؤُلَاءِ» للجمع.","Body parts. Attached pronouns: ra2suhu (his), famii (my), a3rifuka (know you). haa2ulaa2i = these."]],["النَّظَافَةُ","🧼",[["سَعِيدَةٌ","sa3iidatun","happy","😊"],["يَعْمَلُ","ya3malu","works / does","🛠️"],["يَغْسِلُ","yaghsilu","washes","🧺"],["يَكْنُسُ","yaknusu","sweeps","🧹"],["مِنْشَفَةٌ","minshafatun","towel","🧻"],["صَابُونٌ","Saabuunun","soap","🧼"],["أَسْنَانٌ","asnaanun","teeth","🦷"],["مَعْجُونٌ","ma3juunun","toothpaste","🪥"],["فُرْشَاةُ الْأَسْنَانِ","furshaatu al-asnaani","toothbrush","🪥"],["نَظَافَةٌ","naZaafatun","cleanliness","✨"],["الَّذِي","alladhii","which / who (m.)","👉"],["الَّتِي","allatii","which / who (f.)","👉"]],[["قاسم","أَنْتِ سَعِيدَةٌ يَا ابْنَتِي الْيَوْمَ.","anti sa3iidatun yaa ibnatii alyawma.","You're happy today, my daughter."],["خولة","عَمِلْتُ كَثِيرًا الْيَوْمَ.","3amiltu kathiiran alyawma.","I worked a lot today."],["قاسم","مَاذَا عَمِلْتِ؟","maadhaa 3amilti?","What did you do?"],["خولة","أَحْضَرْتُ الْمِنْشَفَةَ لِأُخْتِي.","a7Dartu alminshafata li2ukhtii.","I brought the towel for my sister."],["قاسم","مَتَى؟","mataa?","When?"],["خولة","وَهِيَ تَكْنُسُ الْبَيْتَ.","wahiya taknusu albayta.","While she was sweeping the house."],["قاسم","جَيِّدٌ.","jayyidun.","Good."],["خولة","وَأَحْضَرْتُ لِأُمِّي الصَّابُونَ.","wa2a7Dartu li2ummii aS-Saabuuna.","And I brought Mum the soap."],["قاسم","مَتَى؟","mataa?","When?"],["خولة","وَهِيَ تَغْسِلُ الْمَلَابِسَ.","wahiya taghsilu almalaabisa.","While she was washing the clothes."],["قاسم","أَنْتِ تُحِبِّينَ النَّظَافَةَ.","anti tu7ibbiina an-naZaafata.","You love cleanliness."],["خولة","سَأُحْضِرُ لَكَ فُرْشَاةَ الْأَسْنَانِ الَّتِي طَلَبْتَ.","sa2u7Diru laka furshaata al-asnaani allatii Talabta.","I'll bring you the toothbrush you asked for."],["قاسم","وَالْمَعْجُونَ الَّذِي طَلَبْتُ.","wal-ma3juuna alladhii Talabtu.","And the toothpaste I asked for."]],["الاسم الموصول: الَّذِي للمذكر (الْمَعْجُونُ الَّذِي)، الَّتِي للمؤنث (الْفُرْشَاةُ الَّتِي). «وَهِيَ تَكْنُسُ» = وهي بتكنس (حال).","alladhii (m.) / allatii (f.) = which/that. wa-hiya taknusu = while she was sweeping."]],["مَنْ هُنَا؟","🏡",[["غُرَفٌ","ghurafun","rooms","🚪"],["غُرْفَةُ نَوْمٍ","ghurfatu nawmin","bedroom","🛏️"],["غُرْفَةُ جُلُوسٍ","ghurfatu juluusin","living room","🛋️"],["غُرْفَةُ طَعَامٍ","ghurfatu Ta3aamin","dining room","🍽️"],["حَمَّامٌ","7ammaamun","bathroom","🛁"],["مَطْبَخٌ","maTbakhun","kitchen","🍳"],["حَدِيقَةٌ","7adiiqatun","garden","🌳"],["أَلْعَابٌ","al3aabun","toys / games","🧸"],["جِدَارٌ","jidaarun","wall","🧱"],["أَسْكُنُ","askunu","I live","🏠"],["صَوْتٌ","Sawtun","voice / echo","🔊"]],[["محمد","أَسْكُنُ هُنَا.","askunu hunaa.","I live here."],["صوت","أَسْكُنُ هُنَا.","askunu hunaa.","I live here."],["محمد","فِي بَيْتِنَا ثَلَاثُ غُرَفِ نَوْمٍ.","fii baytinaa thalaathu ghurafi nawmin.","Our house has three bedrooms."],["صوت","فِي بَيْتِنَا ثَلَاثُ غُرَفِ نَوْمٍ.","fii baytinaa thalaathu ghurafi nawmin.","Our house has three bedrooms."],["محمد","فِي بَيْتِنَا غُرْفَةٌ لِلْجُلُوسِ.","fii baytinaa ghurfatun liljuluusi.","There's a living room in our house."],["صوت","فِي بَيْتِنَا غُرْفَةٌ لِلْجُلُوسِ.","fii baytinaa ghurfatun liljuluusi.","There's a living room."],["محمد","فِي بَيْتِنَا غُرْفَةٌ لِلْأَلْعَابِ.","fii baytinaa ghurfatun lil2al3aabi.","There's a playroom."],["صوت","فِي بَيْتِنَا غُرْفَةٌ لِلْأَلْعَابِ.","fii baytinaa ghurfatun lil2al3aabi.","There's a playroom."],["محمد","فِي غُرْفَتِي حَمَّامٌ.","fii ghurfatii 7ammaamun.","My room has a bathroom."],["صوت","فِي غُرْفَتِي حَمَّامٌ.","fii ghurfatii 7ammaamun.","My room has a bathroom."],["محمد","غُرْفَتِي بَعِيدَةٌ عَنِ الْمَطْبَخِ.","ghurfatii ba3iidatun 3ani almaTbakhi.","My room is far from the kitchen."],["محمد","فِي بَيْتِنَا حَدِيقَةٌ، وَغُرْفَةُ طَعَامٍ.","fii baytinaa 7adiiqatun, waghurfatu Ta3aamin.","Our house has a garden and a dining room."],["محمد","مَنْ خَلْفَ الْجِدَارِ؟","man khalfa aljidaari?","Who's behind the wall?"],["صوت","مَنْ خَلْفَ الْجِدَارِ؟","man khalfa aljidaari?","Who's behind the wall?"]],["«فِي بَيْتِنَا …» = عندنا في البيت. الإضافة: غُرْفَةُ نَوْمٍ، غُرَفُ نَوْمٍ. «ثَلَاثُ غُرَفٍ» (العدد عكس المعدود).","fii baytinaa … = our house has … Idaafa: ghurfatu nawm. thalaathu ghuraf (number agrees in reverse)."]],["الْجِهَاتُ الْأَرْبَعُ","🧭",[["حَزِينٌ","7aziinun","sad","😢"],["قَبْلَ","qabla","before","⏮️"],["مَسْجِدٌ","masjidun","mosque","🕌"],["آخِرٌ","aakhirun","last","🔚"],["يَنْتَقِلُ","yantaqilu","moves","🚚"],["غَرْبٌ","gharbun","west","⬅️"],["جَنُوبٌ","januubun","south","⬇️"],["شَرْقٌ","sharqun","east","➡️"],["شَمَالٌ","shamaalun","north","⬆️"],["يَسْتَطِيعُ","yastaTii3u","can","💪"]],[["ميمونة","لِمَاذَا أَنْتَ حَزِينٌ يَا فَضْلُ؟","limaadhaa anta 7aziinun yaa faDlu?","Why are you sad, Fadl?"],["فضل","سَعْدٌ يَرَى الشَّمْسَ قَبْلِي.","sa3dun yaraa ash-shamsa qablii.","Sa'd sees the sun before me."],["ميمونة","بَيْتُهُمْ شَرْقَ بَيْتِنَا.","baytuhum sharqa baytinaa.","Their house is east of ours."],["فضل","سَعْدٌ أَوَّلُ مَنْ يَرَاهَا كُلَّ يَوْمٍ.","sa3dun awwalu man yaraahaa kulla yawmin.","Sa'd is the first to see it every day."],["ميمونة","وَأَنْتَ آخِرُ مَنْ يَرَاهَا.","wa2anta aakhiru man yaraahaa.","And you're the last to see it."],["فضل","أَصَحِيحٌ يَا أُمِّي؟","aSa7ii7un yaa ummii?","Is that true, Mum?"],["ميمونة","نَعَمْ، فَبَيْتُنَا غَرْبَ بَيْتِهِمْ.","na3am, fabaytunaa gharba baytihim.","Yes, our house is west of theirs."],["فضل","سَأُخْبِرُ سَعْدًا بِذَلِكَ.","sa2ukhbiru sa3dan bidhalika.","I'll tell Sa'd about it."],["فضل","وَمَتَى يَرَى حَارِسُ الْمَدْرَسَةِ الشَّمْسَ؟","wamataa yaraa 7aarisu almadrasati ash-shamsa?","And when does the school guard see the sun?"],["ميمونة","يَرَاهَا مَعَنَا، فَالْمَدْرَسَةُ جَنُوبَ بَيْتِنَا.","yaraahaa ma3anaa, fal-madrasatu januuba baytinaa.","With us — the school is south of our house."],["فضل","وَالْمَسْجِدُ؟","wal-masjidu?","And the mosque?"],["ميمونة","الْمَسْجِدُ شَمَالَ بَيْتِنَا.","almasjidu shamaala baytinaa.","The mosque is north of our house."],["فضل","عَرَفْتُ الْآنَ: شَرْقٌ، غَرْبٌ، شَمَالٌ، جَنُوبٌ.","3araftu al-aana sharqun, gharbun, shamaalun, januubun.","Now I know: east, west, north, south."],["ميمونة","انْتَقِلْ إِلَى بَيْتٍ شَرْقَ بَيْتِ سَعْدٍ.","intaqil ilaa baytin sharqa bayti sa3din.","Move to a house east of Sa'd's."],["فضل","سَأَسْتَطِيعُ أَنْ أَرَى الشَّمْسَ قَبْلَهُ!","sa2astaTii3u an araa ash-shamsa qablahu!","I'll be able to see the sun before him!"]],["الجهات الأربع: شَرْقٌ، غَرْبٌ، شَمَالٌ، جَنُوبٌ — وبتيجي مفتوحة قبل المكان: شَرْقَ بَيْتِنَا. قَبْلَ ≠ بَعْدَ، أَوَّلُ ≠ آخِرُ.","Directions: sharq, gharb, shamaal, januub — sharqa baytinaa (east of our house). qabla ≠ ba3da, awwal ≠ aakhir."]],["الِابْنُ مَرِيضٌ","🚑",[["أَيَّامٌ","ayyaamun","days","📅"],["دَوَاءٌ","dawaa2un","medicine","💊"],["حُلْوٌ","7ulwun","sweet","🍬"],["مُرٌّ","murrun","bitter","🍋"],["بِمَاذَا","bimaadhaa","with what","❓"],["إِلَى أَيْنَ","ilaa ayna","to where","🧭"],["حَرَارَةٌ","7araaratun","fever","🌡️"],["بَرْدٌ","bardun","cold","🥶"],["مُسْتَشْفًى","mustashfan","hospital","🏥"],["إِسْعَافٌ","is3aafun","ambulance","🚑"],["يَتَنَاوَلُ","yatanaawalu","takes (medicine)","💊"],["صُدَاعٌ","Sudaa3un","headache","🤕"],["سَلَامَتُكَ","salaamatuka","get well soon","🙏"]],[["عقيل","غَابَ ابْنُكَ خَمْسَةَ أَيَّامٍ.","ghaaba ibnuka khamsata ayyaamin.","Your son was absent five days."],["حبيب","كَانَ ابْنِي مَرِيضًا.","kaana ibnii mariiDan.","My son was sick."],["عقيل","بِمَاذَا شَعَرَ؟","bimaadhaa sha3ara?","What did he feel?"],["حبيب","شَعَرَ فِي الْيَوْمِ الْأَوَّلِ بِحَرَارَةٍ وَصُدَاعٍ.","sha3ara fii alyawmi al-awwali bi7araaratin waSudaa3in.","On the first day he had a fever and a headache."],["عقيل","طَهُورٌ لَا بَأْسَ.","Tahuurun laa ba2asa.","No harm — it's purification."],["حبيب","وَالْيَوْمَ الثَّانِي شَعَرَ بِبَرْدٍ.","wal-yawma ath-thaanii sha3ara bibardin.","On the second day he felt cold."],["عقيل","سَلَامَتُهُ، وَالْيَوْمَ الثَّالِثَ؟","salaamatuhu, wal-yawma ath-thaalitha?","Get well soon. And the third day?"],["حبيب","جَاءَ الْإِسْعَافُ فِي الْيَوْمِ الثَّالِثِ.","jaa2a al-is3aafu fii alyawmi ath-thaalithi.","The ambulance came on the third day."],["عقيل","إِلَى أَيْنَ ذَهَبَ بِهِ؟","ilaa ayna dhahaba bihi?","Where did it take him?"],["حبيب","ذَهَبَ بِهِ إِلَى الْمُسْتَشْفَى الْقَرِيبِ.","dhahaba bihi ilaa almustashfaa alqariibi.","To the nearby hospital."],["عقيل","وَالْيَوْمَ الرَّابِعَ؟","wal-yawma ar-raabi3a?","And the fourth day?"],["حبيب","أَخَذَ الدَّوَاءَ، شَفَاهُ اللَّهُ.","akhadha ad-dawaa2a, shafaahu allaahu.","He took medicine — may Allah heal him."],["عقيل","هَلِ الدَّوَاءُ مُرٌّ؟","hali ad-dawaa2u murrun?","Is the medicine bitter?"],["حبيب","لَا، هُوَ حُلْوٌ.","laa, huwa 7ulwun.","No, it's sweet."],["عقيل","وَالْيَوْمَ الْخَامِسَ؟","wal-yawma alkhaamisa?","And the fifth day?"],["حبيب","هُوَ فِي الْبَيْتِ يَتَنَاوَلُ الدَّوَاءَ.","huwa fii albayti yatanaawalu ad-dawaa2a.","He's at home taking his medicine."]],["الترتيب: الْأَوَّلُ، الثَّانِي، الثَّالِثُ، الرَّابِعُ، الْخَامِسُ. «طَهُورٌ لَا بَأْسَ» و«سَلَامَتُكَ» للمريض. حُلْوٌ ≠ مُرٌّ.","Ordinals: al-awwal … al-khaamis. Say to the sick: Tahuurun laa ba2s / salaamatuk. Hulw ≠ murr."]],["حَفْلُ الْمَدْرَسَةِ","🎉",[["غَدًا","ghadan","tomorrow","⏭️"],["مَعْهَدٌ","ma3hadun","institute","🏛️"],["يَسْتَعِدُّ","yasta3iddu","gets ready","🏃"],["حَفْلٌ","7aflun","party","🎉"],["حَتَّى","7attaa","until","⏳"],["رَائِعٌ","raa2i3un","wonderful","🤩"],["عِشَاءٌ","3ishaa2un","Isha (night prayer)","🌙"],["مَغْرِبٌ","maghribun","Maghrib","🌇"],["يَنْتَهِي","yantahii","ends","🔚"],["السَّبْتُ","as-sabtu","Saturday","📅"],["هَيَّا بِنَا","hayyaa binaa","let's go","🏃"]],[["عقيل","سَنَبْقَى غَدًا فِي الْمَعْهَدِ حَتَّى السَّادِسَةِ إِنْ شَاءَ اللَّهُ.","sanabqaa ghadan fii alma3hadi 7attaa as-saadisati in shaa2a allaahu.","Tomorrow we'll stay at the institute until six, in sha' Allah."],["معاوية","هَلْ سَنَبْقَى كُلُّنَا يَا أُسْتَاذُ؟","hal sanabqaa kullunaa yaa ustaadhu?","Will all of us stay, teacher?"],["عقيل","نَعَمْ، اسْتَعِدُّوا لِذَلِكَ.","na3am, ista3idduua lidhalika.","Yes, get ready for that."],["محمد","لِمَاذَا يَا أُسْتَاذُ؟","limaadhaa yaa ustaadhu?","Why, teacher?"],["عقيل","الْحَفْلُ يَوْمَ السَّبْتِ.","al7aflu yawma as-sabti.","The party is on Saturday."],["فضل","رَائِعٌ يَا أُسْتَاذُ، فِي أَيِّ وَقْتٍ؟","raa2i3un yaa ustaadhu, fii ayyi waqtin?","Wonderful, teacher! At what time?"],["عقيل","بَعْدَ الْعِشَاءِ.","ba3da al3ishaa2i.","After Isha."],["فضل","مَتَى يَنْتَهِي الْحَفْلُ يَا أُسْتَاذُ؟","mataa yantahii al7aflu yaa ustaadhu?","When does the party end, teacher?"],["عقيل","التَّاسِعَةَ مَسَاءً.","at-taasi3ata masaa2an.","At nine in the evening."],["صالح","وَأَيْنَ سَنُصَلِّي الْعَصْرَ وَالْمَغْرِبَ؟","wa2ayna sanuSallii al3aSra wal-maghriba?","Where will we pray Asr and Maghrib?"],["عقيل","فِي مَسْجِدِ الْمَعْهَدِ، إِنْ شَاءَ اللَّهُ.","fii masjidi alma3hadi, in shaa2a allaahu.","In the institute's mosque, in sha' Allah."],["محمد","هَذَا أَذَانُ الْعَصْرِ يَا أُسْتَاذُ.","hadhaa adhaanu al3aSri yaa ustaadhu.","That's the Asr adhan, teacher."],["عقيل","هَيَّا بِنَا إِلَى الْمَسْجِدِ.","hayyaa binaa ilaa almasjidi.","Let's go to the mosque."]],["«سَـ» + نون الجماعة للمستقبل: سَنَبْقَى، سَنُصَلِّي. أمر الجماعة: اسْتَعِدُّوا. «حَتَّى» = لحد.","sa-na- = we will: sa-nabqaa. Plural command: ista3idduu. Hattaa = until."]],["شَهْرُ رَمَضَانَ","🌙",[["أَبْنَاءٌ","abnaa2un","sons","👦"],["صَوْمٌ","Sawmun","fasting","🌙"],["زَكَاةٌ","zakaatun","zakat","💰"],["قِرَاءَةُ الْقُرْآنِ","qiraa2atu alqur2aani","reading the Qur'an","📖"],["بَنَاتٌ","banaatun","daughters","👧"],["أَوْلَادٌ","awlaadun","children","👨‍👩‍👧"],["شُكْرًا","shukran","thank you","🙏"],["يَحْمِلُ","ya7milu","carries / brings","📦"],["يُعْجِبُ","yu3jibu","pleases","😍"],["فُرْصَةٌ","furSatun","opportunity","🎯"],["خَيْرٌ","khayrun","good","🌟"]],[["ميمونة","اسْتَمِعُوا يَا أَوْلَادِي.","istami3uua yaa awlaadii.","Listen, my children."],["حبيب","هَذَا أَوَّلُ يَوْمٍ مِنْ شَهْرِ رَمَضَانَ.","hadhaa awwalu yawmin min shahri ramaDaana.","This is the first day of Ramadan."],["الجميع","الْحَمْدُ لِلَّهِ.","al7amdu lillahi.","Praise be to Allah."],["حبيب","هُوَ شَهْرُ الصَّوْمِ.","huwa shahru aS-Sawmi.","It's the month of fasting."],["ميمونة","وَهُوَ شَهْرُ قِرَاءَةِ الْقُرْآنِ.","wahuwa shahru qiraa2ati alqur2aani.","And the month of reading the Qur'an."],["حبيب","أَنَا تُعْجِبُنِي قِرَاءَةُ فَضْلٍ.","anaa tu3jibunii qiraa2atu faDlin.","I like Fadl's recitation."],["فضل","شُكْرًا يَا أَبِي.","shukran yaa abii.","Thank you, Dad."],["خديجة","وَمَتَى شَهْرُ الزَّكَاةِ يَا أَبِي؟","wamataa shahru az-zakaati yaa abii?","And when is the month of zakat, Dad?"],["حبيب","لَيْسَ لِلزَّكَاةِ شَهْرٌ يَا ابْنَتِي.","laysa lilzzakaati shahrun yaa ibnatii.","Zakat has no set month, my daughter."],["ميمونة","شَهْرُ رَمَضَانَ يَحْمِلُ لَنَا الْخَيْرَ.","shahru ramaDaana ya7milu lanaa alkhayra.","Ramadan brings us goodness."],["حبيب","هَذِهِ فُرْصَةٌ جَيِّدَةٌ يَا أَبْنَائِي وَيَا بَنَاتِي.","hadhihi furSatun jayyidatun yaa abnaa2ii wayaa banaatii.","This is a great opportunity, my sons and daughters."]],["«تُعْجِبُنِي» = بتعجبني. الجمع: ابْنٌ ← أَبْنَاءٌ، بِنْتٌ ← بَنَاتٌ، وَلَدٌ ← أَوْلَادٌ. «لَيْسَ لِـ…» = مالوش.","tu3jibunii = I like. Plurals: ibn → abnaa2, bint → banaat, walad → awlaad. laysa li- = has no."]]]