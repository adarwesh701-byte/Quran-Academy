[["الشَّرَابُ","🥤",[["يَشْرَبُ","yashrabu","drinks","🥤"],["شَايٌ","shaayun","tea","🍵"],["سُكَّرٌ","sukkarun","sugar","🧂"],["حَلِيبٌ","7aliibun","milk","🥛"],["مَاءٌ","maa2un","water","💧"],["عَصِيرٌ","3aSiirun","juice","🧃"],["قَهْوَةٌ","qahwatun","coffee","☕"],["شَرَابٌ","sharaabun","drink","🍹"],["صَبَاحٌ","Sabaa7un","morning","🌅"],["مَسَاءٌ","masaa2un","evening","🌇"],["لَيْلٌ","laylun","night","🌙"],["أَوْ","aw","or","🔀"],["تَفَضَّلْ","tafaDDal","here you are","🤲"]],[["محمد","أَيَّ شَرَابٍ تُرِيدُ يَا مُعَاوِيَةُ؟","ayya sharaabin turiidu yaa mu3aawiyatu?","Which drink do you want, Mu'awiya?"],["معاوية","أَشْرَبُ الشَّايَ بِالسُّكَّرِ.","ashrabu ash-shaaya bis-sukkari.","I drink tea with sugar."],["محمد","لِمَاذَا لَا تَشْرَبُ الْقَهْوَةَ؟","limaadhaa laa tashrabu alqahwata?","Why don't you drink coffee?"],["معاوية","أَشْرَبُ الْقَهْوَةَ فِي الصَّبَاحِ.","ashrabu alqahwata fii aS-Sabaa7i.","I drink coffee in the morning."],["محمد","وَمَاذَا تَشْرَبُ فِي الْمَسَاءِ؟","wamaadhaa tashrabu fii almasaa2i?","And what do you drink in the evening?"],["معاوية","أَشْرَبُ الشَّايَ أَوِ الْحَلِيبَ.","ashrabu ash-shaaya awi al7aliiba.","Tea or milk."],["محمد","وَمَاذَا تَشْرَبُ فِي اللَّيْلِ؟","wamaadhaa tashrabu fii al-layli?","And at night?"],["معاوية","أَشْرَبُ الْمَاءَ أَوْ أَشْرَبُ الْعَصِيرَ.","ashrabu almaa2a aw ashrabu al3aSiira.","Water or juice."],["محمد","تَفَضَّلِ الشَّايَ.","tafaDDali ash-shaaya.","Here's the tea."]],["«لَا» قبل المضارع للنفي: لَا تَشْرَبُ. «أَوْ» للاختيار. أوقات اليوم: صَبَاحٌ، مَسَاءٌ، لَيْلٌ.","laa + present = don't: laa tashrabu. aw = or. SabaaH, masaa2, layl."]],["عِيسَى مَرِيضٌ الْيَوْمَ","🤒",[["يَتْرُكُ","yatruku","leaves","🚪"],["صَلَاةٌ","Salaatun","prayer","🕌"],["الْفَجْرُ","alfajru","Fajr","🌄"],["الظُّهْرُ","aZ-Zuhru","Dhuhr","☀️"],["السَّاعَةُ الْوَاحِدَةُ","as-saa3atu alwaa7idatu","one o'clock","🕐"],["السَّاعَةُ الْخَامِسَةُ","as-saa3atu alkhaamisatu","five o'clock","🕔"],["السَّاعَةُ الثَّانِيَةَ عَشْرَةَ","as-saa3atu ath-thaaniyata 3ashrata","twelve o'clock","🕛"],["شَفَاهُ اللَّهُ","shafaahu allaahu","may Allah heal him","🤲"],["مَرِيضٌ","mariiDun","sick","🤒"],["حَالٌ","7aalun","condition","❓"],["بَعْدَ","ba3da","after","⏭️"]],[["قاسم","عِيسَى مَرِيضٌ الْيَوْمَ.","3iisaa mariiDun alyawma.","Isa is sick today."],["محمد","شَفَاهُ اللَّهُ.","shafaahu allaahu.","May Allah heal him."],["قاسم","كُنْتُ مَعَهُ السَّاعَةَ الْوَاحِدَةَ لَيْلًا.","kuntu ma3ahu as-saa3ata alwaa7idata laylan.","I was with him at one o'clock at night."],["محمد","وَكَيْفَ حَالُ أُمِّي؟","wakayfa 7aalu ummii?","And how is Mum?"],["قاسم","مَرِيضَةٌ أَيْضًا.","mariiDatun ayDan.","She's sick too."],["محمد","شَفَاهَا اللَّهُ.","shafaahaa allaahu.","May Allah heal her."],["قاسم","ذَهَبْتُ السَّاعَةَ الْخَامِسَةَ لِصَلَاةِ الْفَجْرِ، وَذَهَبْتُ السَّاعَةَ الثَّانِيَةَ عَشْرَةَ لِصَلَاةِ الظُّهْرِ.","dhahabtu as-saa3ata alkhaamisata liSalaati alfajri, wadhahabtu as-saa3ata ath-thaaniyata 3ashrata liSalaati aZ-Zuhri.","I went at five for Fajr, and at twelve for Dhuhr."],["محمد","مَتَى تَرَكْتَهُ؟","mataa taraktahu?","When did you leave him?"],["قاسم","بَعْدَ الصَّلَاةِ.","ba3da aS-Salaati.","After the prayer."]],["الساعة: السَّاعَةُ الْوَاحِدَةُ، الثَّانِيَةُ، … الثَّانِيَةَ عَشْرَةَ (العدد بيبقى على وزن فاعِلة). «شَفَاهُ اللَّهُ» للولد و«شَفَاهَا اللَّهُ» للبنت.","Time: as-saa3atu l-waaHida, ath-thaaniya … ath-thaaniyata 3ashrata. shafaahu llaah (him) / shafaahaa llaah (her)."]],["مَنْ غَابَ الْيَوْمَ؟","🏫",[["يَغِيبُ","yaghiibu","is absent","🚫"],["يَقُومُ","yaquumu","stands up","🧍"],["يُجِيبُ","yujiibu","answers","🙋"],["قِصَّةٌ","qiSSatun","story","📖"],["أَوَّلًا","awwalan","first","1️⃣"],["سَفَرٌ","safarun","travel","🧳"],["يَتَأَخَّرُ","yata2akhkharu","is late","⏰"],["يَتَكَلَّمُ","yatakallamu","speaks","🗣️"],["الْأَخِيرُ","al-akhiiru","the last","🔚"],["الْأُولَى","al-uulaa","the first (f.)","🥇"]],[["المعلم","مَنْ غَابَ الْيَوْمَ؟","man ghaaba alyawma?","Who is absent today?"],["محمد","سَعِيدٌ غَابَ الْيَوْمَ.","sa3iidun ghaaba alyawma.","Sa'id is absent today."],["المعلم","اقْرَأِ الْقِصَّةَ الْأُولَى يَا مُحَمَّدُ.","iqra2i alqiSSata al-uulaa yaa mu7ammadu.","Read the first story, Muhammad."],["محمد","حَاضِرٌ يَا أُسْتَاذُ.","7aaDirun yaa ustaadhu.","Yes, teacher."],["المعلم","الْآنَ أَجِبْ: مَنْ قَامَ؟","al-aana ajib man qaama?","Now answer: who stood up?"],["محمد","عَلِيٌّ قَامَ أَوَّلًا، ثُمَّ أَحْمَدُ.","3aliyyun qaama awwalan, thumma a7madu.","Ali stood up first, then Ahmad."],["المعلم","لِمَاذَا قَامَ عَلِيٌّ؟","limaadhaa qaama 3aliyyun?","Why did Ali stand up?"],["محمد","قَامَ لِيَرْكَبَ الطَّائِرَةَ.","qaama liyarkaba aT-Taa2irata.","He stood up to board the plane."],["المعلم","مَنْ جَلَسَ فِي الصَّفِّ الْأَخِيرِ؟","man jalasa fii aS-Saffi al-akhiiri?","Who sat in the last row?"],["محمد","سَلِيمٌ.","saliimun.","Salim."],["المعلم","مَنْ تَكَلَّمَ أَوَّلًا؟","man takallama awwalan?","Who spoke first?"],["محمد","سَعِيدٌ تَكَلَّمَ أَوَّلًا.","sa3iidun takallama awwalan.","Sa'id spoke first."],["المعلم","مَنْ تَأَخَّرَ عَنِ السَّفَرِ؟","man ta2akhkhara 3ani as-safari?","Who was late for the trip?"],["محمد","فَيْصَلٌ تَأَخَّرَ عَنِ السَّفَرِ.","faySalun ta2akhkhara 3ani as-safari.","Faisal was late for the trip."]],["«مَنْ؟» للسؤال عن الشخص اللي عمل الفعل: مَنْ غَابَ؟ ← سَعِيدٌ غَابَ. «لِـ» قبل الفعل للسبب: لِيَرْكَبَ.","man? = who did it: man ghaaba? → sa3iidun ghaaba. li- + verb = in order to."]],["الْمَلَابِسُ","👕",[["يَعْرِفُ","ya3rifu","knows","🧠"],["قَمِيصٌ","qamiiSun","shirt","👔"],["ثَوْبٌ","thawbun","thobe / robe","🥻"],["حِجَابٌ","7ijaabun","hijab","🧕"],["نَظِيفٌ","naZiifun","clean","✨"],["مُتَّسِخٌ","muttasikhun","dirty","💩"],["مَفْتُوحٌ","maftuu7un","open","🔓"],["مُغْلَقٌ","mughlaqun","closed","🔒"],["أَسْوَدُ","aswadu","black","⚫"],["أَبْيَضُ","abyaDu","white","⚪"]],[["صالح","هَلْ تَعْرِفُ خَالِدًا؟","hal ta3rifu khaalidan?","Do you know Khalid?"],["محمد","نَعَمْ، هُوَ يَلْبَسُ قَمِيصًا مَفْتُوحًا.","na3am, huwa yalbasu qamiiSan maftuu7an.","Yes, he's wearing an open shirt."],["صالح","وَهَلْ تَعْرِفُ مَسْعُودًا؟","wahal ta3rifu mas3uudan?","And do you know Mas'ud?"],["محمد","نَعَمْ، هُوَ يَلْبَسُ ثَوْبًا أَبْيَضَ.","na3am, huwa yalbasu thawban abyaDa.","Yes, he wears a white thobe."],["صالح","وَهَلْ تَعْرِفُ عَلِيًّا؟","wahal ta3rifu 3aliyyan?","And Ali?"],["محمد","نَعَمْ، هُوَ يَلْبَسُ قَمِيصًا مُغْلَقًا وَحِذَاءً أَسْوَدَ.","na3am, huwa yalbasu qamiiSan mughlaqan wa7idhaa2an aswada.","Yes, he wears a closed shirt and black shoes."],["صالح","وَهَلْ تَعْرِفُ خَدِيجَةَ؟","wahal ta3rifu khadiijata?","And do you know Khadija?"],["محمد","نَعَمْ، هِيَ تَلْبَسُ حِجَابًا أَخْضَرَ وَحِذَاءً أَزْرَقَ.","na3am, hiya talbasu 7ijaaban akhDara wa7idhaa2an azraqa.","Yes, she wears a green hijab and blue shoes."],["صالح","وَأَيْنَ نِزَارٌ؟","wa2ayna nizaarun?","And where's Nizar?"],["محمد","نِزَارٌ هُنَاكَ، ثَوْبُهُ مُتَّسِخٌ، وَثَوْبُ وَالِدِهِ نَظِيفٌ.","nizaarun hunaaka, thawbuhu muttasikhun, wathawbu waalidihi naZiifun.","Nizar is there; his thobe is dirty and his father's is clean."]],["«يَلْبَسُ» للولد و«تَلْبَسُ» للبنت. الصفة بعد الاسم: قَمِيصًا مَفْتُوحًا. نَظِيفٌ ≠ مُتَّسِخٌ، مَفْتُوحٌ ≠ مُغْلَقٌ.","yalbasu (he) / talbasu (she). Adjective follows the noun. naZiif ≠ muttasikh, maftuuH ≠ mughlaq."]],["مَاذَا تُرِيدُ؟","🍌",[["فَاكِهَةٌ","faakihatun","fruit","🍎"],["مَوْزٌ","mawzun","banana","🍌"],["لَيْمُونٌ","laymuunun","lemon","🍋"],["تَمْرٌ","tamrun","dates","🌴"],["بُرْتُقَالٌ","burtuqaalun","orange","🍊"],["كِيلُو","kiiluu","kilo","⚖️"],["نِصْفٌ","niSfun","half","½"],["ثُلُثٌ","thuluthun","third","⅓"],["رُبُعٌ","rubu3un","quarter","¼"],["يَكْفِي","yakfii","is enough","👌"],["سُفْرَةٌ","sufratun","dining spread","🍽️"]],[["المشتري","أُرِيدُ فَاكِهَةً.","uriidu faakihatan.","I want fruit."],["البائع","أَيَّ فَاكِهَةٍ تُرِيدُ؟","ayya faakihatin turiidu?","Which fruit do you want?"],["المشتري","أُرِيدُ مَوْزًا.","uriidu mawzan.","I want bananas."],["البائع","كَمْ كِيلُو تُرِيدُ؟","kam kiiluu turiidu?","How many kilos?"],["المشتري","أُرِيدُ نِصْفَ كِيلُو.","uriidu niSfa kiiluu.","Half a kilo."],["البائع","هَلْ تُرِيدُ لَيْمُونًا؟","hal turiidu laymuunan?","Do you want lemons?"],["المشتري","لَا، أُرِيدُ رُبُعَ كِيلُو بُرْتُقَالًا.","laa, uriidu rubu3a kiiluu burtuqaalan.","No, a quarter kilo of oranges."],["البائع","خُذْ تَمْرًا أَيْضًا.","khudh tamran ayDan.","Take some dates too."],["المشتري","جَيِّدٌ، أَعْطِنِي ثُلُثَ كِيلُو تَمْرًا.","jayyidun, a3Tinii thulutha kiiluu tamran.","Good, give me a third of a kilo of dates."],["البائع","هَلْ هَذَا يَكْفِي؟","hal hadhaa yakfii?","Is that enough?"],["المشتري","نَعَمْ، هَذَا يَكْفِي لِلسُّفْرَةِ الْيَوْمَ.","na3am, hadhaa yakfii lilssufrati alyawma.","Yes, that's enough for today's meal."]],["الكسور: نِصْفٌ ½، ثُلُثٌ ⅓، رُبُعٌ ¼. «كَمْ كِيلُو؟» و«أَيَّ فَاكِهَةٍ؟».","Fractions: niSf ½, thuluth ⅓, rubu3 ¼. kam kiilu? / ayya faakihatin?"]],["الطَّعَامُ عَلَى الْمَائِدَةِ","🍽️",[["يَضَعُ","yaDa3u","puts","🫳"],["يُحِبُّ","yu7ibbu","loves","❤️"],["طَبَقٌ","Tabaqun","plate","🍽️"],["كُوبٌ","kuubun","cup","🥛"],["كَأْسٌ","ka2asun","glass","🥃"],["بَصَلٌ","baSalun","onion","🧅"],["طَمَاطِمُ","TamaaTimu","tomatoes","🍅"],["شَوْكَةٌ","shawkatun","fork","🍴"],["سِكِّينٌ","sikkiinun","knife","🔪"],["مِلْعَقَةٌ","mil3aqatun","spoon","🥄"],["مَائِدَةٌ","maa2idatun","table","🪑"],["طَعَامٌ","Ta3aamun","food","🍲"],["ضُيُوفٌ","Duyuufun","guests","👥"],["حَسَنًا فَعَلْتِ","7asanan fa3alti","well done","👏"]],[["الأم","وَصَلَ الضُّيُوفُ يَا خَوْلَةُ.","waSala aD-Duyuufu yaa khawlatu.","The guests have arrived, Khawla."],["خولة","الطَّعَامُ عَلَى الْمَائِدَةِ.","aT-Ta3aamu 3alaa almaa2idati.","The food is on the table."],["الأم","مَاذَا وَضَعْتِ مِنَ الْأَكْلِ يَا خَوْلَةُ؟","maadhaa waDa3ti mina al-akli yaa khawlatu?","What food did you put out, Khawla?"],["خولة","وَضَعْتُ طَبَقَ الرُّزِّ.","waDa3tu Tabaqa ar-ruzzi.","I put out the plate of rice."],["الأم","وَمَاذَا وَضَعْتِ أَيْضًا؟","wamaadhaa waDa3ti ayDan?","What else?"],["خولة","وَوَضَعْتُ كُوبَ الْحَلِيبِ.","wawaDa3tu kuuba al7aliibi.","And the cup of milk."],["الأم","أَنَا أُحِبُّ الْبَصَلَ، وَأُحِبُّ الطَّمَاطِمَ مَعَ الْعَشَاءِ.","anaa u7ibbu albaSala, wa2u7ibbu aT-TamaaTima ma3a al3ashaa2i.","I love onions, and tomatoes with dinner."],["خولة","مَوْجُودَةٌ.","mawjuudatun.","They're there."],["الأم","وَهَلْ وَضَعْتِ لِكُلِّ وَاحِدٍ شَوْكَةً وَسِكِّينًا وَمِلْعَقَةً؟","wahal waDa3ti likulli waa7idin shawkatan wasikkiinan wamil3aqatan?","Did you put a fork, knife and spoon for everyone?"],["خولة","نَعَمْ، وَكَأْسًا أَيْضًا.","na3am, waka2asan ayDan.","Yes, and a glass too."],["الأم","حَسَنًا فَعَلْتِ.","7asanan fa3alti.","Well done."]],["الماضي مع البنت: وَضَعْتِ (إنتِ) ← وَضَعْتُ (أنا). «لِكُلِّ وَاحِدٍ» = لكل شخص.","Past: waDa3ti (you f.) → waDa3tu (I). li-kulli waaHid = for everyone."]],["أَيْنَ الْأَكْلُ؟","🍽️",[["صَبَاحُ الْخَيْرِ","Sabaa7u alkhayri","good morning","🌅"],["صَبَاحُ النُّورِ","Sabaa7u an-nuuri","good morning (reply)","☀️"],["دَقِيقَةٌ","daqiiqatun","minute","⏱️"],["أَذَانٌ","adhaanun","call to prayer","🕌"],["يَجْهَزُ","yajhazu","gets ready","✅"],["مِلْحٌ","mil7un","salt","🧂"],["بَطَاطِسُ","baTaaTisu","potatoes","🥔"],["عُشْرٌ","3ushrun","a tenth","🔟"],["يَطْلُبُ","yaTlubu","orders / asks for","🙋"],["عِنَبٌ","3inabun","grapes","🍇"],["عَفْوًا","3afwan","sorry / excuse me","🙏"]],[["عقيل","السَّلَامُ عَلَيْكُمْ.","as-salaamu 3alaykum.","Peace be upon you."],["النادل","وَعَلَيْكُمُ السَّلَامُ.","wa3alaykumu as-salaamu.","And upon you peace."],["عقيل","صَبَاحُ الْخَيْرِ.","Sabaa7u alkhayri.","Good morning."],["النادل","صَبَاحُ النُّورِ.","Sabaa7u an-nuuri.","Good morning to you."],["عقيل","أَيْنَ الْأَكْلُ؟ بَقِيَ عِشْرُونَ دَقِيقَةً.","ayna al-aklu? baqiya 3ishruuna daqiiqatan.","Where's the food? Twenty minutes left."],["النادل","عَلَى مَاذَا؟","3alaa maadhaa?","Until what?"],["عقيل","عَلَى أَذَانِ الظُّهْرِ.","3alaa adhaani aZ-Zuhri.","Until the Dhuhr adhan."],["النادل","سَيَجْهَزُ إِنْ شَاءَ اللَّهُ.","sayajhazu in shaa2a allaahu.","It'll be ready, in sha' Allah."],["عقيل","أَحْضَرْتَ الْمِلْحَ، وَأَحْضَرْتَ الْبَطَاطِسَ، وَلَمْ تُحْضِرِ الْأَكْلَ!","a7Darta almil7a, wa2a7Darta albaTaaTisa, walam tu7Diri al-akla!","You brought the salt and the potatoes, but not the food!"],["النادل","عَفْوًا يَا أُسْتَاذُ.","3afwan yaa ustaadhu.","Sorry, sir."],["عقيل","عُشْرُ هَذَا الْوَقْتِ يَكْفِي.","3ushru hadhaa alwaqti yakfii.","A tenth of this time is enough."],["النادل","أَنْتَ طَلَبْتَ عَصِيرَ عِنَبٍ.","anta Talabta 3aSiira 3inabin.","You ordered grape juice."]],["التحية: صَبَاحُ الْخَيْرِ ← صَبَاحُ النُّورِ. «لَمْ» + المضارع للنفي في الماضي: لَمْ تُحْضِرْ.","SabaaHu l-khayr → SabaaHu n-nuur. lam + present = didn't: lam tuHDir."]],["قَلَمِي","✏️",[["مَسَاءُ الْخَيْرِ","masaa2u alkhayri","good evening","🌇"],["مَسَاءُ النُّورِ","masaa2u an-nuuri","good evening (reply)","🌙"],["وَلَدٌ","waladun","boy / son","👦"],["يَنْظُرُ","yanZuru","looks","👀"],["مِرْآةٌ","mir2aatun","mirror","🪞"],["بِسَاطٌ","bisaaTun","rug","🧶"],["قَوِيٌّ","qawiyyun","strong","💪"],["سَوْفَ","sawfa","will","🔜"],["تَجِدُهُ","tajiduhu","you'll find it","🔍"],["رَأَيْتُهُ","ra2aytuhu","I saw it","👁️"]],[["الأم","السَّلَامُ عَلَيْكُمْ يَا وَلَدِي.","as-salaamu 3alaykum yaa waladii.","Peace be upon you, my son."],["فضل","وَعَلَيْكُمُ السَّلَامُ.","wa3alaykumu as-salaamu.","And upon you peace."],["الأم","مَسَاءُ الْخَيْرِ.","masaa2u alkhayri.","Good evening."],["فضل","مَسَاءُ النُّورِ يَا أُمِّي.","masaa2u an-nuuri yaa ummii.","Good evening, Mum."],["الأم","مَاذَا تَفْعَلُ؟","maadhaa taf3alu?","What are you doing?"],["فضل","أَبْحَثُ عَنْ قَلَمِي.","ab7athu 3an qalamii.","I'm looking for my pen."],["الأم","ابْحَثْ عَنْهُ وَسَوْفَ تَجِدُهُ.","ib7ath 3anhu wasawfa tajiduhu.","Look for it and you'll find it."],["فضل","لَمْ أَجِدِ الْقَلَمَ.","lam ajidi alqalama.","I didn't find the pen."],["الأم","ابْحَثْ تَحْتَ السَّرِيرِ.","ib7ath ta7ta as-sariiri.","Look under the bed."],["فضل","لَيْسَ الْقَلَمُ مَوْجُودًا.","laysa alqalamu mawjuudan.","The pen isn't there."],["الأم","ابْحَثْ خَلْفَ الْبَابِ.","ib7ath khalfa albaabi.","Look behind the door."],["فضل","لَيْسَ الْقَلَمُ مَوْجُودًا.","laysa alqalamu mawjuudan.","It isn't there."],["الأم","ابْحَثْ فَوْقَ الْبِسَاطِ.","ib7ath fawqa albisaaTi.","Look on the rug."],["فضل","لَيْسَ مَوْجُودًا.","laysa mawjuudan.","It isn't there."],["الأم","انْظُرْ إِلَى الْمِرْآةِ، وَسَوْفَ تَجِدُهُ.","inZur ilaa almir2aati, wasawfa tajiduhu.","Look in the mirror and you'll find it."],["فضل","رَأَيْتُهُ!","ra2aytuhu!","I saw it!"],["الأم","أَنْتَ قَوِيٌّ يَا فَضْلُ.","anta qawiyyun yaa faDlu.","You're strong, Fadl."]],["«سَوْفَ» + المضارع للمستقبل: سَوْفَ تَجِدُهُ. «لَيْسَ» + اسم منصوب: لَيْسَ مَوْجُودًا. مَسَاءُ الْخَيْرِ ← مَسَاءُ النُّورِ.","sawfa + present = will. laysa … mawjuudan. masaa2u l-khayr → masaa2u n-nuur."]]]