[["الْأَلْوَانُ","🎨",[["أَحْمَرُ / حَمْرَاءُ","a7maru 7amraa2u","red","🔴"],["أَصْفَرُ / صَفْرَاءُ","aSfaru Safraa2u","yellow","🟡"],["أَخْضَرُ / خَضْرَاءُ","akhDaru khaDraa2u","green","🟢"],["أَزْرَقُ / زَرْقَاءُ","azraqu zarqaa2u","blue","🔵"],["أَسْوَدُ / سَوْدَاءُ","aswadu sawdaa2u","black","⚫"],["أَبْيَضُ / بَيْضَاءُ","abyaDu bayDaa2u","white","⚪"],["كُرَةٌ","kuratun","ball","⚽"],["سَاعَةٌ","saa3atun","watch","⌚"],["نَظَّارَةٌ","naZZaaratun","glasses","👓"],["حَقِيبَةٌ","7aqiibatun","bag","🎒"],["أُرِيدُ","uriidu","I want","🙋"],["أَيُّ","ayyu","which","❓"]],[["محمد","أُرِيدُ حَقِيبَةً يَا أَبِي.","uriidu 7aqiibatan yaa abii.","I want a bag, Dad."],["قاسم","أَيَّ حَقِيبَةٍ تُرِيدُ؟","ayya 7aqiibatin turiidu?","Which bag do you want?"],["محمد","أُرِيدُ الْحَقِيبَةَ الصَّفْرَاءَ.","uriidu al7aqiibata aS-Safraa2a.","I want the yellow bag."],["قاسم","خُذْهَا.","khudhhaa.","Take it."],["محمد","أُرِيدُ كُرَةً يَا أَبِي.","uriidu kuratan yaa abii.","I want a ball, Dad."],["قاسم","هَلْ تُرِيدُ الْكُرَةَ الزَّرْقَاءَ؟","hal turiidu alkurata az-zarqaa2a?","Do you want the blue ball?"],["محمد","لَا، أُرِيدُ الْكُرَةَ الْخَضْرَاءَ.","laa, uriidu alkurata alkhaDraa2a.","No, I want the green ball."],["قاسم","حَسَنًا، وَأَنَا أُرِيدُ سَاعَةً لِأُمِّكَ.","7asanan, wa2anaa uriidu saa3atan li2ummika.","Okay, and I want a watch for your mother."],["محمد","هَلْ تُرِيدُ السَّاعَةَ الْحَمْرَاءَ؟","hal turiidu as-saa3ata al7amraa2a?","Do you want the red watch?"],["قاسم","لَا، أُرِيدُ الْبَيْضَاءَ.","laa, uriidu albayDaa2a.","No, I want the white one."]],["اللون مع المؤنث بيتغيّر: أَحْمَرُ ← حَمْرَاءُ، أَصْفَرُ ← صَفْرَاءُ. «أَيُّ؟» للاختيار. التنوين: ـً ـٌ ـٍ.","Colours change with feminine nouns: a7mar → 7amraa2. ayyu? = which. Tanween: -an, -un, -in."]],["بَيْتِي","🏠",[["بَيْتٌ","baytun","house","🏠"],["كَبِيرٌ","kabiirun","big","🐘"],["صَغِيرٌ","Saghiirun","small","🐜"],["بَابٌ","baabun","door","🚪"],["طَرِيقٌ","Tariiqun","road","🛣️"],["أَبْحَثُ عَنْ","ab7athu 3an","I look for","🔍"],["تَفْعَلُ","taf3alu","you do","🛠️"],["مَاذَا","maadhaa","what","❓"],["وَقْتٌ","waqtun","time","⏳"],["خَلْفَ","khalfa","behind","🔙"],["أَمَامَ","amaama","in front of","🔜"],["لَيْسَ","laysa","is not","🚫"]],[["محمد","مَاذَا تَفْعَلُ فِي الطَّرِيقِ؟","maadhaa taf3alu fii aT-Tariiqi?","What are you doing on the road?"],["فضل","أَبْحَثُ عَنْ بَيْتِي، بَيْتِي كَبِيرٌ وَبَابُهُ صَغِيرٌ.","ab7athu 3an baytii, baytii kabiirun wabaabuhu Saghiirun.","I'm looking for my house; it's big and its door is small."],["محمد","مَاذَا تُرِيدُ؟","maadhaa turiidu?","What do you want?"],["فضل","أُرِيدُ وَقْتًا طَوِيلًا.","uriidu waqtan Tawiilan.","I need a long time."],["محمد","هَلْ أُخْبِرُكَ؟","hal ukhbiruka?","Shall I tell you?"],["فضل","نَعَمْ.","na3am.","Yes."],["محمد","هُوَ خَلْفَكَ، لَيْسَ أَمَامَكَ!","huwa khalfaka, laysa amaamaka!","It's behind you, not in front of you!"]],["«مَاذَا؟» للسؤال عن الحاجة أو الفعل. «خَلْفَ ≠ أَمَامَ». «لَيْسَ» للنفي: لَيْسَ أَمَامَكَ.","maadhaa? = what. khalfa ≠ amaama. laysa = is not."]],["أَدَوَاتِي الْمَدْرَسِيَّةُ","✏️",[["كِتَابٌ","kitaabun","book","📘"],["دَفْتَرٌ","daftarun","notebook","📒"],["قَلَمٌ","qalamun","pen","✏️"],["مِقْلَمَةٌ","miqlamatun","pencil case","🖍️"],["مِسْطَرَةٌ","misTaratun","ruler","📏"],["مِحَّايَةٌ","mi77aayatun","eraser","🧽"],["بَرَّايَةٌ","barraayatun","sharpener","✂️"],["ثَقِيلٌ","thaqiilun","heavy","🏋️"],["خَفِيفٌ","khafiifun","light","🪶"],["هَيَّا","hayyaa","let's go","🏃"],["نَلْعَبُ","nal3abu","we play","⚽"],["خُذْ","khudh","take","✋"]],[["فضل","خُذِ الْبَرَّايَةَ يَا مُعَاوِيَةُ.","khudhi albarraayata yaa mu3aawiyatu.","Take the sharpener, Mu'awiya."],["معاوية","حَسَنًا، وَخُذْ أَنْتَ الْمِحَّايَةَ.","7asanan, wakhudh anta almi77aayata.","Okay, and you take the eraser."],["فضل","خُذْ أَنْتَ الْمِسْطَرَةَ.","khudh anta almisTarata.","You take the ruler."],["معاوية","أَنَا آخُذُ الْمِقْلَمَةَ.","anaa aakhudhu almiqlamata.","I'll take the pencil case."],["فضل","خُذْ أَنْتَ الْقَلَمَ وَالْكِتَابَ.","khudh anta alqalama wal-kitaaba.","You take the pen and the book."],["معاوية","وَأَنَا آخُذُ الدَّفْتَرَ.","wa2anaa aakhudhu ad-daftara.","And I'll take the notebook."],["فضل","هَيَّا إِلَى الْبَيْتِ.","hayyaa ilaa albayti.","Let's go home."],["معاوية","هَيَّا نَلْعَبُ!","hayyaa nal3abu!","Let's play!"],["فضل","أَنْتَ ثَقِيلٌ.","anta thaqiilun.","You are heavy."],["معاوية","وَأَنْتَ خَفِيفٌ.","wa2anta khafiifun.","And you are light."]],["«خُذْ» للولد و«خُذِي» للبنت. «آخُذُ» = أنا. الكلمة وعكسها: ثَقِيلٌ ≠ خَفِيفٌ.","khudh (boy) / khudhii (girl) = take. aakhudhu = I take. thaqiil ≠ khafiif."]],["عُصْفُورِي","🐦",[["عُصْفُورٌ","3uSfuurun","bird","🐦"],["سَبُّورَةٌ","sabbuuratun","board","🟩"],["نَافِذَةٌ","naafidhatun","window","🪟"],["عَلَى","3alaa","on","⬆️"],["إِلَى","ilaa","to","➡️"],["مِنْ","min","from","⬅️"],["فِي","fii","in","📦"],["خَرَجَ","kharaja","went out","🚶"],["دَخَلَ","dakhala","went in","🚪"],["عَادَ","3aada","came back","🔄"],["ذَهَبَ","dhahaba","went","🏃"]],[["محمد","أَيْنَ الْعُصْفُورُ؟","ayna al3uSfuuru?","Where is the bird?"],["فضل","الْعُصْفُورُ خَرَجَ.","al3uSfuuru kharaja.","The bird went out."],["محمد","مِنْ أَيْنَ خَرَجَ؟","min ayna kharaja?","Where did it come out from?"],["فضل","خَرَجَ مِنَ الْحَقِيبَةِ.","kharaja mina al7aqiibati.","It came out of the bag."],["محمد","أَيْنَ ذَهَبَ؟","ayna dhahaba?","Where did it go?"],["فضل","ذَهَبَ إِلَى النَّافِذَةِ.","dhahaba ilaa an-naafidhati.","It went to the window."],["محمد","أَخْضَرُ!","akhDaru!","Green!"],["فضل","هُوَ عَلَى السَّبُّورَةِ.","huwa 3alaa as-sabbuurati.","It's on the board."],["محمد","أَخْضَرُ!","akhDaru!","Green!"],["فضل","حَسَنًا، هُوَ بَعِيدٌ عَنِّي.","7asanan, huwa ba3iidun 3annii.","Okay, it's far from me."],["فضل","عَادَ إِلَى الْحَقِيبَةِ وَدَخَلَ فِيهَا.","3aada ilaa al7aqiibati wadakhala fiihaa.","It came back to the bag and went inside."]],["حروف الجر: مِنْ (من مكان)، إِلَى (لمكان)، عَلَى (فوق)، فِي (جوّه). خَرَجَ ≠ دَخَلَ.","min = from, ilaa = to, 3alaa = on, fii = in. kharaja ≠ dakhala."]],["أَسْمَاءُ أَهْلِ الْقَرْيَةِ","📖",[["أَسْمَاءٌ","asmaa2un","names","📛"],["أَهْلٌ","ahlun","people / family","👨‍👩‍👧"],["قَرْيَةٌ","qaryatun","village","🏘️"],["صَفْحَةٌ","Saf7atun","page","📄"],["سَطْرٌ","saTrun","line","➖"],["كَلِمَةٌ","kalimatun","word","🔤"],["حَرْفٌ","7arfun","letter","🅰️"],["مَوْجُودٌ","mawjuudun","there / present","✅"],["كُلٌّ","kullun","all","💯"],["لَمْ أَجِدْهُ","lam ajidhu","I didn't find it","🤷"],["وَجَدْتُهُ","wajadtuhu","I found it","🎉"]],[["محمد","مَا هَذَا الْكِتَابُ؟","maa hadhaa alkitaabu?","What is this book?"],["قاسم","هَذَا كِتَابُ الْأَسْمَاءِ.","hadhaa kitaabu al-asmaa2i.","This is the book of names."],["محمد","أَسْمَاءُ مَنْ؟","asmaa2u man?","Whose names?"],["قاسم","أَسْمَاءُ أَهْلِ الْقَرْيَةِ.","asmaa2u ahli alqaryati.","The names of the village people."],["محمد","هَلِ الْأَسْمَاءُ كُلُّهَا مَوْجُودَةٌ؟","hali al-asmaa2u kulluhaa mawjuudatun?","Are all the names there?"],["قاسم","نَعَمْ.","na3am.","Yes."],["محمد","هَلِ اسْمِي مَعَهُمْ؟","hali ismii ma3ahum?","Is my name with them?"],["قاسم","نَعَمْ.","na3am.","Yes."],["محمد","أَيْنَ اسْمِي؟","ayna ismii?","Where is my name?"],["قاسم","فِي الصَّفْحَةِ السَّابِعَةِ، فِي السَّطْرِ الْخَامِسِ.","fii aS-Saf7ati as-saabi3ati, fii as-saTri alkhaamisi.","On page seven, line five."],["محمد","لَمْ أَجِدْهُ.","lam ajidhu.","I didn't find it."],["قاسم","الْكَلِمَةُ السَّابِعَةُ، أَوَّلُ حَرْفٍ مِنِ اسْمِكَ مِيمٌ.","alkalimatu as-saabi3atu, awwalu 7arfin mini ismika miimun.","The seventh word — your name starts with Meem."],["محمد","صَحِيحٌ، وَجَدْتُهُ!","Sa7ii7un, wajadtuhu!","Right, I found it!"]],["«مَا؟» للحاجة و«مَنْ؟» للشخص. «هَلْ؟» للسؤال وإجابته نَعَمْ أو لَا. «لَمْ» للنفي في الماضي: لَمْ أَجِدْهُ.","maa? = what (thing), man? = who. hal? → na3am / laa. lam = did not."]],["قِطَّتِي","🐱",[["قِطَّةٌ","qiTTatun","cat","🐱"],["سَرِيرٌ","sariirun","bed","🛏️"],["فَوْقَ","fawqa","above","⬆️"],["تَحْتَ","ta7ta","under","⬇️"],["الْيَمِينُ","alyamiinu","right","👉"],["الشِّمَالُ","ash-shimaalu","left","👈"],["بَيْنَ","bayna","between","↔️"],["هُنَاكَ","hunaaka","there","📍"],["لِمَاذَا","limaadhaa","why","❓"],["لُعْبَةٌ","lu3batun","toy","🧸"],["جَمِيلَةٌ","jamiilatun","beautiful","🌸"],["هِيَ","hiya","she / it","👧"]],[["فاطمة","لِمَاذَا أَنْتَ فَوْقَ السَّرِيرِ؟","limaadhaa anta fawqa as-sariiri?","Why are you on the bed?"],["محمد","أَبْحَثُ عَنِ الْقِطَّةِ لُؤْلُؤَ.","ab7athu 3ani alqiTTati lu2lu2a.","I'm looking for the cat, Lulu."],["فاطمة","إِنَّهَا تَحْتَ السَّرِيرِ.","innahaa ta7ta as-sariiri.","She is under the bed."],["محمد","أَيْنَ ذَهَبَتْ؟","ayna dhahabat?","Where did she go?"],["فاطمة","ذَهَبَتْ هُنَاكَ.","dhahabat hunaaka.","She went over there."],["محمد","أَيْنَ هِيَ يَا أُمِّي؟","ayna hiya yaa ummii?","Where is she, Mum?"],["فاطمة","فَوْقَ الْحَقِيبَةِ.","fawqa al7aqiibati.","On top of the bag."],["محمد","أَيْنَ هِيَ؟","ayna hiya?","Where is she?"],["فاطمة","ذَهَبَتْ إِلَى الْيَمِينِ… ثُمَّ إِلَى الشِّمَالِ.","dhahabat ilaa alyamiini thumma ilaa ash-shimaali.","She went right… then left."],["محمد","أَيْنَ هِيَ؟","ayna hiya?","Where is she?"],["فاطمة","بَيْنَ السَّرِيرِ وَالْبَابِ.","bayna as-sariiri wal-baabi.","Between the bed and the door."],["محمد","هَذِهِ لُعْبَةٌ جَمِيلَةٌ!","hadhihi lu3batun jamiilatun!","This is a lovely game!"]],["كلمات المكان: فَوْقَ ≠ تَحْتَ، الْيَمِينُ ≠ الشِّمَالُ، بَيْنَ، هُنَا ≠ هُنَاكَ. «لِمَاذَا؟» للسؤال عن السبب.","Place words: fawqa ≠ ta7ta, al-yamiin ≠ ash-shimaal, bayna, hunaa ≠ hunaaka. limaadhaa? = why."]],["مِنْ أَيْنَ أَتَيْتَ؟","🕌",[["أَتَيْتُ","ataytu","I came","🚶"],["أَمْسِ","amsi","yesterday","⏮️"],["الْيَوْمَ","alyawma","today","☀️"],["مَدْرَسَةٌ","madrasatun","school","🏫"],["طَالِبٌ","Taalibun","student","🧑‍🎓"],["طُلَّابٌ","Tullaabun","students","👥"],["صَفٌّ","Saffun","class","🪑"],["أَدْرُسُ","adrusu","I study","📚"],["أَيُّ","ayyu","which","❓"],["سَأُصَلِّي","sa2uSallii","I will pray","🕌"],["سَأَتَوَضَّأُ","sa2atawaDDa2u","I will do wudu","💧"]],[["قاسم","مَتَى أَتَيْتَ؟","mataa atayta?","When did you come?"],["عقيل","أَتَيْتُ أَمْسِ.","ataytu amsi.","I came yesterday."],["قاسم","أَهْلًا بِكَ، مِنْ أَيْنَ أَتَيْتَ؟","ahlan bika, min ayna atayta?","Welcome! Where did you come from?"],["عقيل","أَتَيْتُ مِنَ الْقَرْيَةِ.","ataytu mina alqaryati.","I came from the village."],["قاسم","هَذَا ابْنِي مُحَمَّدٌ، هُوَ طَالِبٌ.","hadhaa ibnii mu7ammadun, huwa Taalibun.","This is my son Muhammad; he is a student."],["محمد","أَهْلًا بِكَ، لَمْ أَذْهَبْ إِلَى الْمَدْرَسَةِ الْيَوْمَ.","ahlan bika, lam adhhab ilaa almadrasati alyawma.","Welcome! I didn't go to school today."],["عقيل","فِي أَيِّ مَدْرَسَةٍ تَدْرُسُ؟","fii ayyi madrasatin tadrusu?","Which school do you study at?"],["محمد","أَدْرُسُ فِي مَدْرَسَةِ الْقِبْلَةِ.","adrusu fii madrasati alqiblati.","I study at Al-Qibla school."],["عقيل","فِي أَيِّ صَفٍّ تَدْرُسُ؟","fii ayyi Saffin tadrusu?","Which class are you in?"],["محمد","أَنَا مِنْ طُلَّابِ الصَّفِّ الثَّالِثِ.","anaa min Tullaabi aS-Saffi ath-thaalithi.","I'm in the third class."],["عقيل","أَنَا سَأُصَلِّي.","anaa sa2uSallii.","I'm going to pray."],["قاسم","وَأَنَا سَأَتَوَضَّأُ.","wa2anaa sa2atawaDDa2u.","And I'm going to do wudu."]],["«مِنْ أَيْنَ؟» للسؤال عن المكان اللي جيت منه. «سَـ» قبل الفعل للمستقبل: سَأُصَلِّي. همزة الوصل (ابْن، اسْم) مابتتنطقش في وسط الكلام، وهمزة القطع (أَنَا، أَمْس) بتتنطق.","min ayna? = from where. sa- + verb = will: sa-uSallii. Hamzat al-waSl (ibn, ism) is dropped mid-speech; hamzat al-qaT3 (anaa, ams) is always said."]]]