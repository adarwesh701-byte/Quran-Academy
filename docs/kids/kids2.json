[["تَعَارُفٌ ١","👋",[["مَنْ","man","who","❓"],["أَنْتَ","anta","you (boy)","👉"],["أَنَا","anaa","I","🙋"],["مُعَلِّمٌ","mu3allimun","teacher","👨‍🏫"],["هَذَا","hadhaa","this (boy)","👆"],["اِبْنِي","ibnii","my son","👦"],["زَمِيلِي","zamiilii","my classmate","🧑‍🤝‍🧑"],["عُمْرِي","3umrii","my age","🎂"],["سَنَوَاتٌ","sanawaatun","years","📆"],["جَدٌّ","jaddun","grandfather","👴"],["جَدَّةٌ","jaddatun","grandmother","👵"],["أَبٌ","abun","father","👨"],["أُمٌّ","ummun","mother","👩"]],[["الأب","مَنْ أَنْتَ؟","man anta?","Who are you?"],["المعلم","أَنَا مُعَلِّمٌ.","anaa mu3allimun.","I am a teacher."],["المعلم","مَنْ هَذَا؟","man hadhaa?","Who is this?"],["الأب","هَذَا زَمِيلِي حَمْزَةُ، وَهَذَا اِبْنِي مُحَمَّدٌ.","hadhaa zamiilii 7amzatu, wahadhaa ibnii mu7ammadun.","This is my friend Hamza, and this is my son Muhammad."],["المعلم","أَهْلًا وَسَهْلًا، كَمْ عُمْرُكَ يَا مُحَمَّدُ؟","ahlan wasahlan, kam 3umruka yaa mu7ammadu?","Welcome! How old are you, Muhammad?"],["محمد","عُمْرِي سِتُّ سَنَوَاتٍ.","3umrii sittu sanawaatin.","I am six years old."]],["«مَنْ؟» نسأل بيها عن الشخص. «هَذَا» للولد. «كَمْ عُمْرُكَ؟» ← «عُمْرِي…».","man? = who. haadhaa = this (boy). kam 3umruka? → 3umrii … = my age is …"]],["مَنِ الْأَوَّلُ؟","🏃",[["الْأَوَّلُ","al-awwalu","first","🥇"],["الثَّانِي","ath-thaanii","second","🥈"],["الثَّالِثُ","ath-thaalithu","third","🥉"],["الرَّابِعُ","ar-raabi3u","fourth","4️⃣"],["الْخَامِسُ","alkhaamisu","fifth","5️⃣"],["السَّادِسُ","as-saadisu","sixth","6️⃣"],["السَّابِعُ","as-saabi3u","seventh","7️⃣"],["الثَّامِنُ","ath-thaaminu","eighth","8️⃣"],["التَّاسِعُ","at-taasi3u","ninth","9️⃣"],["الْعَاشِرُ","al3aashiru","tenth","🔟"],["الْأَخِيرُ","al-akhiiru","last","🏁"],["نَحِيفٌ","na7iifun","thin","🥢"],["سَمِينٌ","samiinun","fat","🍩"],["مَرِيضٌ","mariiDun","ill","🤒"]],[["فضل","مَنِ الْأَوَّلُ؟","mani al-awwalu?","Who is first?"],["محمد","الْأَوَّلُ مُشْتَاقٌ، هُوَ نَحِيفٌ.","al-awwalu mushtaaqun, huwa na7iifun.","Mushtaq is first; he is thin."],["فضل","وَمَنِ الثَّانِي؟","wamani ath-thaanii?","And who is second?"],["محمد","الثَّانِي أَحْمَدُ، وَالثَّالِثُ أَنَسٌ، وَالرَّابِعُ صَالِحٌ.","ath-thaanii a7madu, wath-thaalithu anasun, war-raabi3u Saali7un.","Second is Ahmad, third Anas, fourth Salih."],["فضل","مَنِ الْخَامِسُ؟","mani alkhaamisu?","Who is fifth?"],["محمد","الْخَامِسُ بَهَاءٌ، وَالسَّادِسُ صَبْرِيٌّ، وَالسَّابِعُ عَاصِمٌ، وَالثَّامِنُ خَيْرِيٌّ، وَالتَّاسِعُ أَنَا.","alkhaamisu bahaa2un, was-saadisu Sabriyyun, was-saabi3u 3aaSimun, wath-thaaminu khayriyyun, wat-taasi3u anaa.","Fifth is Bahaa, sixth Sabri, seventh Asim, eighth Khairi, and ninth is me."],["فضل","وَمَنِ الْعَاشِرُ؟","wamani al3aashiru?","And who is tenth?"],["محمد","أَنْتَ الْعَاشِرُ، أَنْتَ الْأَخِيرُ.","anta al3aashiru, anta al-akhiiru.","You are tenth — you are last."],["فضل","أَنَا مَرِيضٌ.","anaa mariiDun.","I am ill."],["محمد","أَنْتَ سَمِينٌ!","anta samiinun!","You are fat!"]],["الترتيب للولد: الْأَوَّلُ، الثَّانِي، الثَّالِثُ… الْعَاشِرُ، والْأَخِيرُ. «مَنِ الْأَوَّلُ؟» ← «الْأَوَّلُ …».","Ordinals (boys): al-awwal, ath-thaanii, ath-thaalith … al-3aashir, al-akhiir = last."]],["مَنِ الْأُولَى؟","🏅",[["الْأُولَى","al-uulaa","first (girl)","🥇"],["الثَّانِيَةُ","ath-thaaniyatu","second (girl)","🥈"],["الثَّالِثَةُ","ath-thaalithatu","third (girl)","🥉"],["الرَّابِعَةُ","ar-raabi3atu","fourth (girl)","4️⃣"],["الْخَامِسَةُ","alkhaamisatu","fifth (girl)","5️⃣"],["الْعَاشِرَةُ","al3aashiratu","tenth (girl)","🔟"],["أُخْتٌ","ukhtun","sister","👧"],["أَنْتِ","anti","you (girl)","👉"],["قَلَمٌ","qalamun","pen","✏️"],["سَيَّارَةٌ","sayyaaratun","car","🚗"],["حَقِيبَةٌ","7aqiibatun","bag","🎒"],["مُبَارَكٌ","mubaarakun","congratulations","🎉"]],[["هبة","مَنِ الْأُولَى؟","mani al-uulaa?","Who is first?"],["سمية","الْأُولَى أُخْتِي سُمَيَّةُ.","al-uulaa ukhtii sumayyatu.","First is my sister Sumayya."],["هبة","وَمَنِ الثَّانِيَةُ؟","wamani ath-thaaniyatu?","And who is second?"],["سمية","أَنْتِ الثَّانِيَةُ.","anti ath-thaaniyatu.","You are second."],["هبة","لَا، أَنَا لَسْتُ الثَّانِيَةَ، أَنَا الثَّالِثَةُ.","laa, anaa lastu ath-thaaniyata, anaa ath-thaalithatu.","No, I am not second — I am third."],["سمية","مُبَارَكٌ!","mubaarakun!","Congratulations!"]],["للبنت بنزوّد «ـة»: الثَّانِيَةُ، الثَّالِثَةُ… إلا «الْأُولَى». «أَنْتِ» للبنت و«أَنْتَ» للولد.","For girls add -a: ath-thaaniya, ath-thaalitha… except al-uulaa. anti = you (girl), anta = you (boy)."]],["تَعَارُفٌ ٢","👩‍👧",[["هَذِهِ","hadhihi","this (girl)","👆"],["وَالِدَتِي","waalidatii","my mother","👩"],["وَالِدِي","waalidii","my father","👨"],["زَمِيلَتِي","zamiilatii","my classmate (girl)","👭"],["اِبْنَتِي","ibnatii","my daughter","👧"],["أَرْبَعُونَ","arba3uuna","forty","4️⃣0️⃣"],["عَامٌ","3aamun","year","📆"],["السَّلَامُ عَلَيْكُمْ","as-salaamu 3alaykum","peace be upon you","👋"],["أَهْلًا وَسَهْلًا","ahlan wasahlan","welcome","🤗"],["كَيْفَ حَالُكِ؟","kayfa 7aaluki?","how are you? (girl)","🙂"]],[["بتول","هَذِهِ هِبَةُ.","hadhihi hibatu.","This is Hiba."],["هبة","السَّلَامُ عَلَيْكُمْ.","as-salaamu 3alaykum.","Peace be upon you."],["بتول","وَعَلَيْكُمُ السَّلَامُ، هَذِهِ وَالِدَتِي.","wa3alaykumu as-salaamu, hadhihi waalidatii.","And upon you peace. This is my mother."],["هبة","أَهْلًا وَسَهْلًا.","ahlan wasahlan.","Welcome."],["بتول","وَهَذِهِ زَمِيلَتِي لَطِيفَةُ.","wahadhihi zamiilatii laTiifatu.","And this is my friend Latifa."],["هبة","كَمْ عُمْرُكِ يَا لَطِيفَةُ؟","kam 3umruki yaa laTiifatu?","How old are you, Latifa?"],["لطيفة","عُمْرِي أَرْبَعُونَ عَامًا.","3umrii arba3uuna 3aaman.","I am forty years old."],["هبة","وَهَذِهِ اِبْنَتِي.","wahadhihi ibnatii.","And this is my daughter."],["بتول","أَهْلًا وَسَهْلًا.","ahlan wasahlan.","Welcome."]],["«هَذِهِ» للبنت و«هَذَا» للولد. «كَمْ عُمْرُكِ؟» للبنت و«كَمْ عُمْرُكَ؟» للولد.","haadhihi = this (girl), haadhaa = this (boy). kam 3umruki? (girl) / kam 3umruka? (boy)"]],["أُسْرَةُ مُحَمَّدٍ","👨‍👩‍👦",[["جَدِّي","jaddii","my grandfather","👴"],["أَخِي","akhii","my brother","👦"],["عَمِّي","3ammii","my uncle (father's side)","🧔"],["خَالِي","khaalii","my uncle (mother's side)","👨"],["صَدِيقِي","Sadiiqii","my friend","🤝"],["بَيْتٌ","baytun","house","🏠"],["يَوْمٌ","yawmun","day","☀️"],["أَيْنَ","ayna","where","📍"],["ذَهَبَ","dhahaba","he went","🚶"],["يُصَلِّي","yuSallii","he prays","🕌"],["آسِفٌ","aasifun","sorry","🙏"],["شَفَاكَ اللَّهُ","shafaaka allaahu","may Allah heal you","💚"],["فِي","fii","in","📦"]],[["فضل","السَّلَامُ عَلَيْكُمْ يَا صَدِيقِي.","as-salaamu 3alaykum yaa Sadiiqii.","Peace be upon you, my friend."],["محمد","وَعَلَيْكُمُ السَّلَامُ، هَذَا جَدِّي، وَهَذَا أَخِي.","wa3alaykumu as-salaamu, hadhaa jaddii, wahadhaa akhii.","And upon you peace. This is my grandfather, and this is my brother."],["فضل","أَهْلًا وَسَهْلًا، أَيْنَ عَمُّكَ؟","ahlan wasahlan, ayna 3ammuka?","Welcome! Where is your uncle?"],["محمد","عَمِّي ذَهَبَ.","3ammii dhahaba.","My uncle has gone."],["فضل","أَيْنَ أَنْتَ الْيَوْمَ؟","ayna anta alyawma?","Where were you today?"],["محمد","آسِفٌ، أَنَا مَرِيضٌ.","aasifun, anaa mariiDun.","Sorry, I am ill."],["فضل","شَفَاكَ اللَّهُ، أَيْنَ صَلَّيْتَ الْيَوْمَ؟","shafaaka allaahu, ayna Sallayta alyawma?","May Allah heal you. Where did you pray today?"],["محمد","صَلَّيْتُ فِي الْبَيْتِ أَنَا وَخَالِي.","Sallaytu fii albayti anaa wakhaalii.","I prayed at home with my uncle."]],["«أَيْنَ؟» للسؤال عن المكان ← «فِي الْبَيْتِ». «ـي» في الآخر = بتاعي: جَدِّي، أَخِي، عَمِّي.","ayna? = where → fii l-bayt = at home. -ii at the end = my: jaddii, akhii, 3ammii."]],["حِذَائِي","👟",[["حِذَاءٌ","7idhaa2un","shoe","👟"],["بَعِيدٌ","ba3iidun","far","🔭"],["قَرِيبٌ","qariibun","near","🤏"],["طَوِيلٌ","Tawiilun","tall","🦒"],["قَصِيرٌ","qaSiirun","short","🐭"],["صَحِيحٌ","Sa7ii7un","right / true","✅"],["أَعْطِنِي","a3Tinii","give me","🤲"],["لَنْ","lan","will not","🚫"],["مَتَى","mataa","when","⏰"],["خُذْ","khudh","take","✋"],["حَسَنًا","7asanan","okay","👌"]],[["محمد","الْحِذَاءُ بَعِيدٌ.","al7idhaa2u ba3iidun.","The shoe is far."],["صالح","صَحِيحٌ، بَعِيدٌ.","Sa7ii7un, ba3iidun.","True, it's far."],["محمد","أَعْطِنِي الْحِذَاءَ.","a3Tinii al7idhaa2a.","Give me the shoe."],["صالح","لَنْ أُعْطِيَكَ الْحِذَاءَ.","lan u3Tiyaka al7idhaa2a.","I won't give you the shoe."],["محمد","مَتَى تُعْطِينِي الْحِذَاءَ؟","mataa tu3Tiinii al7idhaa2a?","When will you give me the shoe?"],["صالح","أَنَا قَصِيرٌ، وَأَنْتَ طَوِيلٌ.","anaa qaSiirun, wa2anta Tawiilun.","I'm short and you're tall."],["محمد","حَسَنًا، خُذِ الْحِذَاءَ.","7asanan, khudhi al7idhaa2a.","Okay, take the shoe."],["صالح","الْحِذَاءُ قَرِيبٌ!","al7idhaa2u qariibun!","The shoe is near!"]],["«مَتَى؟» للسؤال عن الوقت. «لَنْ» للنفي بعدين: لَنْ أُعْطِيَكَ. الكلمة وعكسها: بَعِيدٌ ≠ قَرِيبٌ، طَوِيلٌ ≠ قَصِيرٌ.","mataa? = when. lan = will not. Opposites: ba3iid ≠ qariib, Tawiil ≠ qaSiir."]],["أُسْرَةُ بَتُولَ","👨‍👩‍👧‍👦",[["جَدَّتِي","jaddatii","my grandmother","👵"],["زَوْجٌ","zawjun","husband","🤵"],["زَوْجَةٌ","zawjatun","wife","👰"],["أَطْفَالٌ","aTfaalun","children","🧒"],["صَدِيقَةٌ","Sadiiqatun","friend (girl)","👭"],["مَعَ","ma3a","with","➕"],["مِنْ فَضْلِكِ","min faDliki","please (to a girl)","🙏"],["مَعَ السَّلَامَةِ","ma3a as-salaamati","goodbye","👋"],["أُخْتِي","ukhtii","my sister","👧"]],[["لطيفة","السَّلَامُ عَلَيْكُمْ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ.","as-salaamu 3alaykum wara7matu allaahi wabarakaatuhu.","Peace, mercy and blessings of Allah be upon you."],["بتول","وَعَلَيْكُمُ السَّلَامُ وَرَحْمَةُ اللَّهِ وَبَرَكَاتُهُ.","wa3alaykumu as-salaamu wara7matu allaahi wabarakaatuhu.","And upon you peace, mercy and blessings of Allah."],["لطيفة","مَنْ هَذِهِ مِنْ فَضْلِكِ؟","man hadhihi min faDliki?","Who is this, please?"],["بتول","هَذِهِ جَدَّتِي عَلْيَاءُ.","hadhihi jaddatii 3alyaa2u.","This is my grandmother Alyaa."],["لطيفة","أَهْلًا وَسَهْلًا، وَمَنْ هَذِهِ؟","ahlan wasahlan, waman hadhihi?","Welcome! And who is this?"],["بتول","هَذِهِ أُخْتِي، وَهَذِهِ صَدِيقَتِي.","hadhihi ukhtii, wahadhihi Sadiiqatii.","This is my sister, and this is my friend."],["صفية","أَهْلًا وَسَهْلًا، أَنَا صَفِيَّةُ زَوْجَةُ أَخِي.","ahlan wasahlan, anaa Safiyyatu zawjatu akhii.","Welcome, I am Safiyya, my brother's wife."],["بتول","أَهْلًا وَسَهْلًا، أَيْنَ زَوْجُكِ؟","ahlan wasahlan, ayna zawjuki?","Welcome! Where is your husband?"],["صفية","زَوْجِي فِي السَّيَّارَةِ مَعَ أَطْفَالِنَا.","zawjii fii as-sayyaarati ma3a aTfaalinaa.","My husband is in the car with our children."],["لطيفة","مَعَ السَّلَامَةِ.","ma3a as-salaamati.","Goodbye."]],["«مِنْ فَضْلِكِ» للطلب بأدب. «مَعَ» = ويّا. «زَوْجِي» للست و«زَوْجَتِي» للراجل.","min faDliki = please. ma3a = with. zawjii = my husband, zawjatii = my wife."]],["الْأَيَّامُ","📅",[["السَّبْتُ","as-sabtu","Saturday","1️⃣"],["الْأَحَدُ","al-a7adu","Sunday","2️⃣"],["الْإِثْنَيْنِ","al-ithnayni","Monday","3️⃣"],["الثُّلَاثَاءُ","ath-thulaathaa2u","Tuesday","4️⃣"],["الْأَرْبِعَاءُ","al-arbi3aa2u","Wednesday","5️⃣"],["الْخَمِيسُ","alkhamiisu","Thursday","6️⃣"],["الْجُمُعَةُ","aljumu3atu","Friday","🕌"],["أُسْبُوعٌ","usbuu3un","week","🗓️"],["لَيْلَةٌ","laylatun","night","🌙"],["وَسَطٌ","wasaTun","middle","🎯"],["تَزُورُ","tazuuru","you visit","🚗"],["خَالَةٌ","khaalatun","aunt (mother's side)","👩"]],[["فضل","مَتَى تَزُورُ عَمَّكَ؟","mataa tazuuru 3ammaka?","When do you visit your uncle?"],["محمد","يَوْمَ السَّبْتِ وَيَوْمَ الْإِثْنَيْنِ.","yawma as-sabti wayawma al-ithnayni.","On Saturday and Monday."],["فضل","وَمَتَى تَزُورُ جَدَّكَ؟","wamataa tazuuru jaddaka?","And when do you visit your grandfather?"],["محمد","يَوْمَ الْجُمُعَةِ، وَيَوْمَ الْأَحَدِ، وَلَيْلَةَ الثُّلَاثَاءِ.","yawma aljumu3ati, wayawma al-a7adi, walaylata ath-thulaathaa2i.","On Friday, Sunday and Tuesday night."],["فضل","وَمَتَى تَزُورُ خَالَكَ؟","wamataa tazuuru khaalaka?","And when do you visit your uncle (mother's brother)?"],["محمد","يَوْمَ الْخَمِيسِ وَلَيْلَةَ الْأَرْبِعَاءِ.","yawma alkhamiisi walaylata al-arbi3aa2i.","On Thursday and Wednesday night."],["فضل","وَمَتَى تَزُورُ خَالَتَكَ؟","wamataa tazuuru khaalataka?","And your aunt?"],["محمد","أَزُورُهَا وَسَطَ الْأُسْبُوعِ.","azuuruhaa wasaTa al-usbuu3i.","I visit her in the middle of the week."]],["«مَتَى تَزُورُ…؟» ← «يَوْمَ …». الْ الشمسية مابتتنطقش (الشَّمْسُ)، والقمرية بتتنطق (الْقَمَرُ).","mataa tazuuru…? → yawma … . Sun letters hide the l (ash-shams); moon letters keep it (al-qamar)."]]]