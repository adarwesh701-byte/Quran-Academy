[["سَافَرْتُ مِنَ الْقَرْيَةِ إِلَى مَكَّةَ","✈️",[["يُسَافِرُ","yusaafiru","travels","🧳"],["يَرْكَبُ","yarkabu","rides","🚌"],["يَصِلُ","yaSilu","arrives","🏁"],["دَرَّاجَةٌ","darraajatun","bicycle","🚲"],["حَافِلَةٌ","7aafilatun","bus","🚌"],["طَائِرَةٌ","Taa2iratun","plane","✈️"],["قِطَارٌ","qiTaarun","train","🚆"],["سَفِينَةٌ","safiinatun","ship","🚢"],["مَدِينَةٌ","madiinatun","city","🏙️"],["سَنَةٌ","sanatun","year","📅"],["كَيْفَ","kayfa","how","❓"],["ثُمَّ","thumma","then","➡️"],["بَعْدَ","ba3da","after","⏭️"]],[["صالح","كَيْفَ سَافَرْتَ إِلَى مَكَّةَ يَا مُعَاوِيَةُ؟","kayfa saafarta ilaa makkata yaa mu3aawiyatu?","How did you travel to Makkah, Mu'awiya?"],["معاوية","سَافَرْتُ بِالطَّائِرَةِ.","saafartu biT-Taa2irati.","I travelled by plane."],["صالح","وَكَيْفَ سَافَرْتَ مِنَ الْقَرْيَةِ؟","wakayfa saafarta mina alqaryati?","And how did you leave the village?"],["معاوية","سَافَرْتُ مِنَ الْقَرْيَةِ بِالْقِطَارِ.","saafartu mina alqaryati bil-qiTaari.","I left the village by train."],["صالح","ثُمَّ مَاذَا؟","thumma maadhaa?","Then what?"],["معاوية","ثُمَّ رَكِبْنَا الطَّائِرَةَ إِلَى جُدَّةَ.","thumma rakibnaa aT-Taa2irata ilaa juddata.","Then we took the plane to Jeddah."],["صالح","هَلْ مَدِينَةُ جُدَّةَ كَبِيرَةٌ؟","hal madiinatu juddata kabiiratun?","Is Jeddah a big city?"],["معاوية","نَعَمْ، كَبِيرَةٌ.","na3am, kabiiratun.","Yes, big."],["صالح","ثُمَّ مَاذَا؟","thumma maadhaa?","Then what?"],["معاوية","ثُمَّ ذَهَبْنَا بِالْحَافِلَةِ إِلَى مَكَّةَ، ثُمَّ ذَهَبْنَا إِلَى الْمَدِينَةِ بِالسَّيَّارَةِ.","thumma dhahabnaa bil-7aafilati ilaa makkata, thumma dhahabnaa ilaa almadiinati bis-sayyaarati.","Then we went by bus to Makkah, then to Madinah by car."],["صالح","سَأُسَافِرُ إِلَى مِصْرَ بِالدَّرَّاجَةِ، ثُمَّ إِلَى جُدَّةَ بِالسَّفِينَةِ.","sa2usaafiru ilaa miSra bid-darraajati, thumma ilaa juddata bis-safiinati.","I'll travel to Egypt by bike, then to Jeddah by ship."],["معاوية","سَتَصِلُ بَعْدَ سَنَةٍ!","sataSilu ba3da sanatin!","You'll arrive after a year!"]],["«كَيْفَ؟» للسؤال عن الطريقة، والإجابة بـ«بِـ»: بِالطَّائِرَةِ، بِالْقِطَارِ. «ثُمَّ» للترتيب.","kayfa? = how → bi- + transport: bit-Taa2irati. thumma = then."]],["الْمَطَرُ","🌧️",[["مَطَرٌ","maTarun","rain","🌧️"],["غَزِيرٌ","ghaziirun","heavy (rain)","⛈️"],["يَرَى","yaraa","sees","👀"],["يُشَاهِدُ","yushaahidu","watches","📺"],["يَنْزِلُ","yanzilu","comes down","⬇️"],["يَجْلِسُ","yajlisu","sits","🪑"],["يَفْتَحُ","yafta7u","opens","🔓"],["يُغْلِقُ","yughliqu","closes","🔒"],["شَيْءٌ","shay2un","thing","📦"],["الْآنَ","al-aana","now","⏱️"],["جَمِيلٌ","jamiilun","beautiful","🌈"]],[["صالح","مَتَى نَرَى الْمَطَرَ؟","mataa naraa almaTara?","When will we see the rain?"],["معاوية","الْمَطَرُ يَنْزِلُ.","almaTaru yanzilu.","The rain is falling."],["صالح","هَلِ الْمَطَرُ يَنْزِلُ الْآنَ؟","hali almaTaru yanzilu al-aana?","Is it raining now?"],["معاوية","نَعَمْ، أَنَا أُشَاهِدُ الْمَطَرَ الْآنَ.","na3am, anaa ushaahidu almaTara al-aana.","Yes, I'm watching the rain now."],["صالح","حَسَنًا.","7asanan.","Okay."],["معاوية","افْتَحِ النَّافِذَةَ.","ifta7i an-naafidhata.","Open the window."],["صالح","شَيْءٌ جَمِيلٌ!","shay2un jamiilun!","Something beautiful!"],["معاوية","اجْلِسْ يَا صَالِحُ هُنَا.","ijlis yaa Saali7u hunaa.","Sit here, Salih."],["صالح","نَعَمْ، شَيْءٌ جَمِيلٌ.","na3am, shay2un jamiilun.","Yes, something beautiful."],["معاوية","الْمَطَرُ غَزِيرٌ.","almaTaru ghaziirun.","The rain is heavy."],["صالح","أَغْلِقِ النَّافِذَةَ.","aghliqi an-naafidhata.","Close the window."]],["الأمر: افْتَحْ، اجْلِسْ، أَغْلِقْ (وبتتكسر قبل «الـ»: افْتَحِ النَّافِذَةَ). يَفْتَحُ ≠ يُغْلِقُ.","Commands: iftaH, ijlis, aghliq (+i before al-: iftaHi n-naafidha). yaftaHu ≠ yughliqu."]],["فِي السُّوقِ","🛒",[["سُوقٌ","suuqun","market","🏪"],["كُرْسِيٌّ","kursiyyun","chair","🪑"],["طَاوِلَةٌ","Taawilatun","table","🪵"],["قِيمَةٌ","qiimatun","price","🏷️"],["رِيَالٌ","riyaalun","riyal","💵"],["يَبْقَى","yabqaa","remains","➖"],["فَقَطْ","faqaT","only","☝️"],["عِشْرُونَ","3ishruuna","twenty","2️⃣0️⃣"],["ثَلَاثُونَ","thalaathuuna","thirty","3️⃣0️⃣"],["خَمْسُونَ","khamsuuna","fifty","5️⃣0️⃣"],["مِئَةٌ","mi2atun","one hundred","💯"],["كَمْ","kam","how much","❓"]],[["البائع","أَهْلًا بِكَ فِي سُوقِ الْقَرْيَةِ.","ahlan bika fii suuqi alqaryati.","Welcome to the village market."],["محمد","أُرِيدُ الْكُرْسِيَّ وَالْكِتَابَ.","uriidu alkursiyya wal-kitaaba.","I want the chair and the book."],["البائع","هَاتِ قِيمَةَ الْكُرْسِيِّ.","haati qiimata alkursiyyi.","Give me the price of the chair."],["محمد","هَذِهِ قِيمَةُ الْكُرْسِيِّ: عَشَرَةٌ، عِشْرُونَ، ثَلَاثُونَ.","hadhihi qiimatu alkursiyyi 3asharatun, 3ishruuna, thalaathuuna.","Here's the chair's price: ten, twenty, thirty."],["البائع","بَقِيَ خَمْسُونَ، الْقِيمَةُ ثَمَانُونَ.","baqiya khamsuuna, alqiimatu thamaanuuna.","Fifty left — the price is eighty."],["محمد","حَسَنًا، هَذِهِ خَمْسُونَ.","7asanan, hadhihi khamsuuna.","Okay, here's fifty."],["البائع","بَقِيَتْ قِيمَةُ الْكِتَابِ سِتُّونَ رِيَالًا.","baqiyat qiimatu alkitaabi sittuuna riyaalan.","The book is still sixty riyals."],["محمد","هَذِهِ مِئَةٌ، بَقِيَ أَرْبَعُونَ.","hadhihi mi2atun, baqiya arba3uuna.","Here's a hundred — forty change."],["محمد","كَمْ قِيمَةُ الْحَقِيبَةِ؟","kam qiimatu al7aqiibati?","How much is the bag?"],["البائع","قِيمَتُهَا سَبْعُونَ.","qiimatuhaa sab3uuna.","It's seventy."],["محمد","وَكَمْ قِيمَةُ الطَّاوِلَةِ؟","wakam qiimatu aT-Taawilati?","And how much is the table?"],["البائع","قِيمَتُهَا تِسْعُونَ، هَلْ تُرِيدُ الْحَقِيبَةَ وَالطَّاوِلَةَ؟","qiimatuhaa tis3uuna, hal turiidu al7aqiibata waT-Taawilata?","Ninety. Do you want the bag and the table?"],["محمد","لَا، أُرِيدُ الْكُرْسِيَّ وَالْكِتَابَ فَقَطْ.","laa, uriidu alkursiyya wal-kitaaba faqaT.","No, just the chair and the book."]],["العقود: عِشْرُونَ، ثَلَاثُونَ، أَرْبَعُونَ، خَمْسُونَ، سِتُّونَ، سَبْعُونَ، ثَمَانُونَ، تِسْعُونَ، مِئَةٌ. «كَمْ؟» للسؤال عن العدد والسعر.","Tens: 3ishruun 20 … tis3uun 90, mi2a 100. kam? = how much / how many."]],["أَيْنَ مُحَمَّدٌ؟","🏃",[["يَسْتَيْقِظُ","yastayqiZu","wakes up","⏰"],["يَنَامُ","yanaamu","sleeps","😴"],["مُبَكِّرًا","mubakkiran","early","🌅"],["يَمْشِي","yamshii","walks","🚶"],["يَجْرِي","yajrii","runs","🏃"],["يَلْبَسُ","yalbasu","puts on","👕"],["يَخْلَعُ","yakhla3u","takes off","🧥"],["مَلَابِسُ","malaabisu","clothes","👚"],["النَّوْمُ","an-nawmu","sleep","🛌"],["الصِّحَّةُ","aS-Si77atu","health","❤️"],["جَيِّدٌ","jayyidun","good","👍"],["كِبَارٌ","kibaarun","adults","🧔"],["صِغَارٌ","Sighaarun","children","🧒"]],[["الأب","أَيْنَ ابْنِي مُحَمَّدٌ؟","ayna ibnii mu7ammadun?","Where is my son Muhammad?"],["الأم","اسْتَيْقَظَ وَخَرَجَ.","istayqaZa wakharaja.","He woke up and went out."],["الأب","مَتَى نَامَ؟","mataa naama?","When did he sleep?"],["الأم","نَامَ مُبَكِّرًا.","naama mubakkiran.","He slept early."],["الأب","جَيِّدٌ، وَأَيْنَ ذَهَبَ؟","jayyidun, wa2ayna dhahaba?","Good. And where did he go?"],["الأم","ذَهَبَ لِلْجَرْيِ.","dhahaba liljaryi.","He went running."],["الأب","وَمَاذَا لَبِسَ؟","wamaadhaa labisa?","And what did he wear?"],["الأم","لَبِسَ مَلَابِسَ الْجَرْيِ.","labisa malaabisa aljaryi.","He wore running clothes."],["الأب","جَيِّدٌ.","jayyidun.","Good."],["الأم","وَخَلَعَ مَلَابِسَ النَّوْمِ.","wakhala3a malaabisa an-nawmi.","And he took off his pyjamas."],["الأب","الْجَرْيُ جَيِّدٌ لِلصِّحَّةِ.","aljaryu jayyidun lilSSi77ati.","Running is good for health."],["الأم","وَالْمَشْيُ جَيِّدٌ لِلصِّحَّةِ.","wal-mashyu jayyidun lilSSi77ati.","And walking is good for health."],["الأب","جَيِّدٌ لِلْكِبَارِ وَلِلصِّغَارِ.","jayyidun lilkibaari walilSSighaari.","Good for adults and children."]],["الفعل الماضي: نَامَ، خَرَجَ، لَبِسَ، خَلَعَ — والمضارع: يَنَامُ، يَخْرُجُ، يَلْبَسُ، يَخْلَعُ. يَلْبَسُ ≠ يَخْلَعُ.","Past: naama, kharaja, labisa, khala3a — present: yanaamu, yakhruju, yalbasu, yakhla3u."]],["عُمْرِي","🎂",[["عُمْرٌ","3umrun","age","🎂"],["عَامٌ","3aamun","year","📅"],["يَوْمٌ","yawmun","day","☀️"],["يَصِيرُ / يَكُونُ","yaSiiru yakuunu","becomes / will be","🔜"],["مَا شَاءَ اللَّهُ","maa shaa2a allaahu","masha'Allah","🤲"],["أَحَدَ عَشَرَ","a7ada 3ashara","eleven","1️⃣1️⃣"],["اثْنَا عَشَرَ","ithnaa 3ashara","twelve","1️⃣2️⃣"],["ثَلَاثَةَ عَشَرَ","thalaathata 3ashara","thirteen","1️⃣3️⃣"],["أَرْبَعَةَ عَشَرَ","arba3ata 3ashara","fourteen","1️⃣4️⃣"],["خَمْسَةَ عَشَرَ","khamsata 3ashara","fifteen","1️⃣5️⃣"],["سِتَّةَ عَشَرَ","sittata 3ashara","sixteen","1️⃣6️⃣"],["سَبْعَةَ عَشَرَ","sab3ata 3ashara","seventeen","1️⃣7️⃣"],["ثَمَانِيَةَ عَشَرَ","thamaaniyata 3ashara","eighteen","1️⃣8️⃣"],["تِسْعَةَ عَشَرَ","tis3ata 3ashara","nineteen","1️⃣9️⃣"]],[["صالح","كَمْ عُمْرُكَ يَا مُعَاوِيَةُ؟","kam 3umruka yaa mu3aawiyatu?","How old are you, Mu'awiya?"],["معاوية","عُمْرِي أَرْبَعَةَ عَشَرَ عَامًا.","3umrii arba3ata 3ashara 3aaman.","I'm fourteen years old."],["صالح","مَا شَاءَ اللَّهُ.","maa shaa2a allaahu.","Masha'Allah."],["معاوية","وَبَعْدَ تِسْعَةَ عَشَرَ يَوْمًا يَصِيرُ خَمْسَةَ عَشَرَ.","waba3da tis3ata 3ashara yawman yaSiiru khamsata 3ashara.","And in nineteen days it'll be fifteen."],["صالح","أَنَا عُمْرِي سِتَّةَ عَشَرَ عَامًا.","anaa 3umrii sittata 3ashara 3aaman.","I'm sixteen years old."],["معاوية","مَا شَاءَ اللَّهُ.","maa shaa2a allaahu.","Masha'Allah."],["صالح","وَبَعْدَ ثَلَاثَةَ عَشَرَ يَوْمًا يَصِيرُ سَبْعَةَ عَشَرَ.","waba3da thalaathata 3ashara yawman yaSiiru sab3ata 3ashara.","In thirteen days it'll be seventeen."],["معاوية","أَخِي مُحَمَّدٌ عُمْرُهُ أَحَدَ عَشَرَ عَامًا.","akhii mu7ammadun 3umruhu a7ada 3ashara 3aaman.","My brother Muhammad is eleven."],["صالح","وَكَمْ عُمْرُ أُخْتِكَ هَالَةَ؟","wakam 3umru ukhtika haalata?","And how old is your sister Hala?"],["معاوية","عُمْرُهَا اثْنَا عَشَرَ عَامًا.","3umruhaa ithnaa 3ashara 3aaman.","She's twelve."],["صالح","مَتَى يَكُونُ عُمْرِي ثَمَانِيَةَ عَشَرَ؟","mataa yakuunu 3umrii thamaaniyata 3ashara?","When will I be eighteen?"]],["الأعداد من ١١ لـ١٩: جزءين مفتوحين (ثَلَاثَةَ عَشَرَ). «كَمْ عُمْرُكَ؟» والإجابة: عُمْرِي … عَامًا.","11–19: two parts both ending -a (thalaathata 3ashara). kam 3umruka? → 3umrii … 3aaman."]],["مَاذَا قَالَ الْأُسْتَاذُ؟","🧑‍🏫",[["تَعَالَ","ta3aala","come","👋"],["أُسْتَاذٌ","ustaadhun","teacher","🧑‍🏫"],["حَاضِرٌ","7aaDirun","here / yes sir","🙋"],["مَرِيضٌ","mariiDun","sick","🤒"],["يَقُولُ","yaquulu","says","💬"],["يَكْتُبُ","yaktubu","writes","✍️"],["يَقْرَأُ","yaqra2u","reads","📖"],["يَرْسُمُ","yarsumu","draws","🎨"],["يَسْتَمِعُ","yastami3u","listens","👂"],["أَحْسَنُ","a7sanu","better","⭐"],["أَيْضًا","ayDan","also","➕"]],[["معاوية","تَعَالَ يَا صَالِحُ.","ta3aala yaa Saali7u.","Come here, Salih."],["صالح","حَاضِرٌ.","7aaDirun.","Coming."],["معاوية","لَمْ تَأْتِ إِلَى الْمَدْرَسَةِ الْيَوْمَ.","lam ta2ati ilaa almadrasati alyawma.","You didn't come to school today."],["صالح","نَعَمْ، أَنَا مَرِيضٌ.","na3am, anaa mariiDun.","Yes, I'm sick."],["معاوية","تَعَالَ مَعِي.","ta3aala ma3ii.","Come with me."],["صالح","وَمَاذَا دَرَسْتَ مَعَ الْأُسْتَاذِ؟","wamaadhaa darasta ma3a al-ustaadhi?","And what did you study with the teacher?"],["معاوية","قَالَ الْأُسْتَاذُ: اكْتُبْ يَا مُعَاوِيَةُ، اقْرَأْ يَا سَلْمَانُ.","qaala al-ustaadhu iktub yaa mu3aawiyatu, iqra2a yaa salmaanu.","The teacher said: write, Mu'awiya; read, Salman."],["صالح","وَمَاذَا أَيْضًا؟","wamaadhaa ayDan?","What else?"],["معاوية","قَالَ: ارْسُمْ يَا مَرْوَانُ. فَقَالَ مَرْوَانُ: حَاضِرٌ يَا أُسْتَاذُ.","qaala irsum yaa marwaanu. faqaala marwaanu 7aaDirun yaa ustaadhu.","He said: draw, Marwan. Marwan said: yes, teacher."],["صالح","مَرْوَانُ أَحْسَنُ مِنْكَ.","marwaanu a7sanu minka.","Marwan is better than you."],["معاوية","هَذَا صَحِيحٌ.","hadhaa Sa7ii7un.","That's true."],["صالح","وَمَاذَا أَيْضًا؟","wamaadhaa ayDan?","What else?"],["معاوية","قَالَ: اسْتَمِعُوا. وَقَرَأَ، فَاسْتَمَعْنَا.","qaala istami3uua. waqara2a, faastama3naa.","He said: listen (all of you). He read, and we listened."]],["فعل الأمر: اكْتُبْ، اقْرَأْ، ارْسُمْ، اسْتَمِعْ — وللجماعة: اسْتَمِعُوا. «أَحْسَنُ مِنْ» للمقارنة.","Commands: uktub, iqra2, irsum, istami3 — plural: istami3uu. aHsanu min = better than."]],["الْعُمْرَةُ","🕋",[["الْعُمْرَةُ","al3umratu","Umrah","🕋"],["الْحَجُّ","al7ajju","Hajj","🕋"],["شَهْرٌ","shahrun","month","🌙"],["الْمُحَرَّمُ","almu7arramu","Muharram","1️⃣"],["رَجَبٌ","rajabun","Rajab","7️⃣"],["شَعْبَانُ","sha3baanu","Sha'ban","8️⃣"],["رَمَضَانُ","ramaDaanu","Ramadan","9️⃣"],["شَوَّالٌ","shawwaalun","Shawwal","🔟"],["ذُو الْحِجَّةِ","dhuu al7ijjati","Dhul-Hijjah","1️⃣2️⃣"],["يَسْجُدُ","yasjudu","prostrates","🙇"],["يَرْكَعُ","yarka3u","bows","🧎"],["يَسْكُنُ","yaskunu","stays / lives","🏠"],["فُنْدُقٌ","funduqun","hotel","🏨"],["شَقَّةٌ","shaqqatun","flat","🏢"],["إِنْ شَاءَ اللَّهُ","in shaa2a allaahu","in sha' Allah","🤲"]],[["الموظف","هَلْ سَتَذْهَبُ لِلْحَجِّ؟","hal satadhhabu lil7ajji?","Will you go for Hajj?"],["قاسم","لَا، سَأَذْهَبُ لِلْعُمْرَةِ.","laa, sa2adhhabu lil3umrati.","No, I'll go for Umrah."],["الموظف","فِي أَيِّ شَهْرٍ تُرِيدُ؟","fii ayyi shahrin turiidu?","Which month do you want?"],["قاسم","فِي شَهْرِ شَوَّالٍ.","fii shahri shawwaalin.","In Shawwal."],["الموظف","مِنْ شَهْرِ شَوَّالٍ إِلَى شَهْرِ الْمُحَرَّمِ لِلْحَجِّ.","min shahri shawwaalin ilaa shahri almu7arrami lil7ajji.","From Shawwal to Muharram is for Hajj."],["قاسم","صَحِيحٌ، الْحَجُّ فِي شَهْرِ ذِي الْحِجَّةِ.","Sa7ii7un, al7ajju fii shahri dhii al7ijjati.","Right, Hajj is in Dhul-Hijjah."],["الموظف","هُنَاكَ رَجَبٌ وَشَعْبَانُ وَرَمَضَانُ.","hunaaka rajabun washa3baanu waramaDaanu.","There's Rajab, Sha'ban and Ramadan."],["قاسم","نَعَمْ، الْعُمْرَةُ فِي رَمَضَانَ أَحْسَنُ.","na3am, al3umratu fii ramaDaana a7sanu.","Yes, Umrah in Ramadan is better."],["محمد","سَنَرْكَعُ كَثِيرًا، وَنَسْجُدُ كَثِيرًا.","sanarka3u kathiiran, wanasjudu kathiiran.","We'll bow a lot and prostrate a lot."],["قاسم","نَعَمْ، سَنُصَلِّي كَثِيرًا هُنَاكَ إِنْ شَاءَ اللَّهُ.","na3am, sanuSallii kathiiran hunaaka in shaa2a allaahu.","Yes, we'll pray a lot there, in sha' Allah."],["الموظف","وَأَيْنَ سَتَسْكُنُ فِي مَكَّةَ؟","wa2ayna sataskunu fii makkata?","Where will you stay in Makkah?"],["قاسم","فِي فُنْدُقٍ، وَسَيَسْكُنُ عَمِّي فِي شَقَّةٍ.","fii funduqin, wasayaskunu 3ammii fii shaqqatin.","In a hotel, and my uncle will stay in a flat."]],["الشهور الهجرية: الْمُحَرَّمُ، صَفَرٌ، رَبِيعٌ الْأَوَّلُ، رَبِيعٌ الْآخِرُ، جُمَادَى الْأُولَى، جُمَادَى الْآخِرَةُ، رَجَبٌ، شَعْبَانُ، رَمَضَانُ، شَوَّالٌ، ذُو الْقَعْدَةِ، ذُو الْحِجَّةِ. «سَـ» للمستقبل: سَنَرْكَعُ.","Hijri months: Muharram … Dhul-Hijjah. sa- = will: sa-narka3u."]],["لِمَاذَا وَزْنُكَ مُرْتَفِعٌ؟","🍽️",[["وَزْنٌ","waznun","weight","⚖️"],["مُرْتَفِعٌ","murtafi3un","high","📈"],["يَأْكُلُ","ya2akulu","eats","🍴"],["خُبْزٌ","khubzun","bread","🍞"],["فُطُورٌ","fuTuurun","breakfast","🍳"],["غَدَاءٌ","ghadaa2un","lunch","🍛"],["عَشَاءٌ","3ashaa2un","dinner","🍲"],["رُزٌّ","ruzzun","rice","🍚"],["لَحْمٌ","la7mun","meat","🥩"],["بَيْضٌ","bayDun","eggs","🥚"],["سَمَكٌ","samakun","fish","🐟"],["دَجَاجٌ","dajaajun","chicken","🍗"],["مُعْتَدِلٌ","mu3tadilun","moderate","⚖️"],["يَحْتَاجُ","ya7taaju","needs","🙏"]],[["صالح","كَمْ وَزْنُكَ؟","kam waznuka?","How much do you weigh?"],["معاوية","وَزْنِي مُرْتَفِعٌ.","waznii murtafi3un.","My weight is high."],["صالح","لِمَاذَا؟","limaadhaa?","Why?"],["معاوية","آكُلُ كَثِيرًا.","aakulu kathiiran.","I eat a lot."],["صالح","مَاذَا تَأْكُلُ فِي الْفُطُورِ؟","maadhaa ta2akulu fii alfuTuuri?","What do you eat for breakfast?"],["معاوية","آكُلُ الْخُبْزَ، وَآكُلُ مَعَهُ الْبَيْضَ.","aakulu alkhubza, wa2aakulu ma3ahu albayDa.","I eat bread, and eggs with it."],["صالح","وَمَاذَا تَأْكُلُ فِي الْغَدَاءِ؟","wamaadhaa ta2akulu fii alghadaa2i?","And for lunch?"],["معاوية","آكُلُ الرُّزَّ، وَآكُلُ مَعَهُ اللَّحْمَ.","aakulu ar-ruzza, wa2aakulu ma3ahu al-la7ma.","Rice, with meat."],["صالح","وَمَاذَا تَأْكُلُ فِي الْعَشَاءِ؟","wamaadhaa ta2akulu fii al3ashaa2i?","And for dinner?"],["معاوية","آكُلُ السَّمَكَ، وَآكُلُ الدَّجَاجَ.","aakulu as-samaka, wa2aakulu ad-dajaaja.","Fish and chicken."],["صالح","أَكْلٌ مُعْتَدِلٌ، تَحْتَاجُ إِلَى الْمَشْيِ.","aklun mu3tadilun, ta7taaju ilaa almashyi.","Moderate food — you need to walk."]],["«آكُلُ» = أنا، «تَأْكُلُ» = إنت، «يَأْكُلُ» = هو. الوجبات: فُطُورٌ، غَدَاءٌ، عَشَاءٌ. «يَحْتَاجُ إِلَى».","aakulu (I) / ta2kulu (you) / ya2kulu (he). Meals: fuTuur, ghadaa2, 3ashaa2. yaHtaaju ilaa = needs."]]]