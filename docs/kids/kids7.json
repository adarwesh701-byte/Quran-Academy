[["فِي حَدِيقَةِ الْحَيَوَانَاتِ","🦁",[["حَدِيقَةُ الْحَيَوَانَاتِ","7adiiqatu al7ayawaanaati","zoo","🏞️"],["أَسَدٌ","asadun","lion","🦁"],["نَمِرٌ","namirun","tiger","🐅"],["فِيلٌ","fiilun","elephant","🐘"],["زَرَافَةٌ","zaraafatun","giraffe","🦒"],["ذِئْبٌ","dhi2bun","wolf","🐺"],["ثَعْلَبٌ","tha3labun","fox","🦊"],["حَيَوَانٌ","7ayawaanun","animal","🐾"],["قَفَصٌ","qafaSun","cage","🔒"],["دُخُولٌ","dukhuulun","entry","🚪"],["خُرُوجٌ","khuruujun","exit","🚶"],["يَخَافُ","yakhaafu","is afraid","😨"],["مُتَأَكِّدٌ","muta2akkidun","sure","✅"]],[["عمار","هَلْ نَذْهَبُ إِلَى حَدِيقَةِ الْحَيَوَانَاتِ؟","hal nadhhabu ilaa 7adiiqati al7ayawaanaati?","Shall we go to the zoo?"],["صالح","هَلْ يُوجَدُ فِيهَا أَسَدٌ؟","hal yuujadu fiihaa asadun?","Is there a lion there?"],["عمار","نَعَمْ.","na3am.","Yes."],["صالح","لَا، فَأَنَا أَخَافُ مِنَ الْأَسَدِ.","laa, fa2anaa akhaafu mina al-asadi.","No, I'm afraid of lions."],["عمار","لَا تَخَفْ، كُلُّ حَيَوَانٍ فِي قَفَصٍ.","laa takhaf, kullu 7ayawaanin fii qafaSin.","Don't be afraid — every animal is in a cage."],["صالح","مَاذَا سَنَرَى هُنَاكَ؟","maadhaa sanaraa hunaaka?","What will we see there?"],["عمار","سَنَرَى النَّمِرَ وَالْفِيلَ.","sanaraa an-namira wal-fiila.","We'll see the tiger and the elephant."],["صالح","هَلْ سَنَرَى الزَّرَافَةَ؟","hal sanaraa az-zaraafata?","Will we see the giraffe?"],["عمار","نَعَمْ، وَسَنَرَى الذِّئْبَ وَالثَّعْلَبَ.","na3am, wasanaraa adh-dhi2ba wath-tha3laba.","Yes, and the wolf and the fox."],["صالح","هَلْ أَنْتَ مُتَأَكِّدٌ أَنَّ الْأَسَدَ فِي الْقَفَصِ؟","hal anta muta2akkidun anna al-asada fii alqafaSi?","Are you sure the lion is in the cage?"],["عمار","نَعَمْ.","na3am.","Yes."],["صالح","نَذْهَبُ إِنْ شَاءَ اللَّهُ. مَتَى الدُّخُولُ؟ وَمَتَى الْخُرُوجُ؟","nadhhabu in shaa2a allaahu. mataa ad-dukhuulu? wamataa alkhuruuju?","Let's go, in sha' Allah. When do we go in, and when out?"],["عمار","مِنَ الْعَصْرِ إِلَى الْمَغْرِبِ.","mina al3aSri ilaa almaghribi.","From Asr to Maghrib."]],["النهي: «لَا» + المضارع المجزوم: لَا تَخَفْ. «مِنْ … إِلَى …» للمدة. «أَنَّ» بعد مُتَأَكِّدٌ.","Prohibition: laa takhaf = don't be afraid. min … ilaa … = from … to …. muta2akkidun anna = sure that."]],["الثَّعْلَبُ وَطُيُورِي","🦅",[["طُيُورٌ","Tuyuurun","birds","🐦"],["عَصَافِيرُ","3aSaafiiru","sparrows","🐤"],["حَمَامٌ","7amaamun","pigeons","🕊️"],["صَقْرٌ","Saqrun","falcon","🦅"],["كَلْبٌ","kalbun","dog","🐕"],["يَصِيدُ","yaSiidu","hunts","🎯"],["صَوْتٌ","Sawtun","sound","🔊"],["مَكَانٌ","makaanun","place","📍"],["حَلٌّ","7allun","solution","💡"],["يُؤْذِي","yu2dhii","harms","⚠️"],["شَجَرَةٌ","shajaratun","tree","🌳"],["سَمِعَ","sami3a","heard","👂"],["إِذَا","idhaa","if / when","❓"]],[["محمد","أَكَلَ الثَّعْلَبُ طُيُورِي.","akala ath-tha3labu Tuyuurii.","The fox ate my birds."],["صالح","الثَّعْلَبُ يُؤْذِي الْقَرْيَةَ كُلَّهَا.","ath-tha3labu yu2dhii alqaryata kullahaa.","The fox harms the whole village."],["محمد","أَمْسِ أَكَلَ الدَّجَاجَ، وَيَوْمَ الْخَمِيسِ أَكَلَ الْحَمَامَ.","amsi akala ad-dajaaja, wayawma alkhamiisi akala al7amaama.","Yesterday it ate the chickens, and on Thursday the pigeons."],["صالح","هَلْ أَكَلَ الْعَصَافِيرَ؟","hal akala al3aSaafiira?","Did it eat the sparrows?"],["محمد","لَا، الْعَصَافِيرُ فِي مَكَانٍ بَعِيدٍ عَنْهُ.","laa, al3aSaafiiru fii makaanin ba3iidin 3anhu.","No, the sparrows are somewhere far from it."],["صالح","أَيْنَ الْعَصَافِيرُ؟","ayna al3aSaafiiru?","Where are the sparrows?"],["محمد","الْعَصَافِيرُ عَلَى الشَّجَرَةِ.","al3aSaafiiru 3alaa ash-shajarati.","On the tree."],["صالح","وَمَاذَا سَتَفْعَلُ؟","wamaadhaa sataf3alu?","What will you do?"],["محمد","سَأَصِيدُ الثَّعْلَبَ.","sa2aSiidu ath-tha3laba.","I'll hunt the fox."],["صالح","كَيْفَ تَصِيدُهُ؟","kayfa taSiiduhu?","How will you catch it?"],["محمد","سَأُحْضِرُ صَقْرًا لِيَصِيدَ الثَّعْلَبَ.","sa2u7Diru Saqran liyaSiida ath-tha3laba.","I'll bring a falcon to catch it."],["صالح","الصَّقْرُ لَا يَصِيدُ الثَّعْلَبَ.","aS-Saqru laa yaSiidu ath-tha3laba.","A falcon doesn't hunt foxes."],["محمد","مَا الْحَلُّ؟","maa al7allu?","What's the solution?"],["صالح","الثَّعْلَبُ يَخَافُ إِذَا سَمِعَ صَوْتَ الْكَلْبِ.","ath-tha3labu yakhaafu idhaa sami3a Sawta alkalbi.","The fox gets scared when it hears a dog."]],["جمع التكسير: طَيْرٌ ← طُيُورٌ، عُصْفُورٌ ← عَصَافِيرُ. «إِذَا» للشرط: يَخَافُ إِذَا سَمِعَ. «كُلَّهَا» للتوكيد.","Broken plurals: Tayr → Tuyuur, 3uSfuur → 3aSaafiir. idhaa = if/when. kullahaa = all of it."]],["حَاسُوبِي","💻",[["مَسْرُورٌ","masruurun","happy","😄"],["فَضْلٌ","faDlun","class","🏫"],["حَاسُوبٌ","7aasuubun","computer","🖥️"],["حَاسُوبٌ مَحْمُولٌ","7aasuubun ma7muulun","laptop","💻"],["مُفِيدٌ","mufiidun","useful","👍"],["مُبَارَكٌ عَلَيْكَ","mubaarakun 3alayka","congratulations","🎉"],["نَحْنُ","na7nu","we","👥"],["بَارَكَ اللَّهُ فِيكَ","baaraka allaahu fiika","may Allah bless you","🤲"],["كُتُبٌ","kutubun","books","📚"],["رَسَائِلُ","rasaa2ilu","messages","✉️"],["شَبَكَةٌ","shabakatun","network / internet","🌐"],["يُرْسِلُ","yursilu","sends","📤"],["يَشْتَرِي","yashtarii","buys","🛍️"],["يَسْتَقْبِلُ","yastaqbilu","receives","📥"]],[["محمد","أَرَاكَ مَسْرُورًا.","araaka masruuran.","You look happy."],["صالح","اشْتَرَى لِي أَبِي حَاسُوبًا مَحْمُولًا.","ishtaraa lii abii 7aasuuban ma7muulan.","My dad bought me a laptop."],["محمد","مُبَارَكٌ عَلَيْكَ.","mubaarakun 3alayka.","Congratulations."],["صالح","بَارَكَ اللَّهُ فِيكَ.","baaraka allaahu fiika.","May Allah bless you."],["محمد","وَهَلِ الْعَمَلُ عَلَى الْحَاسُوبِ مُفِيدٌ؟","wahali al3amalu 3alaa al7aasuubi mufiidun?","Is working on the computer useful?"],["صالح","نَعَمْ، فَأَنَا أَكْتُبُ فِيهِ، وَأَقْرَأُ فِيهِ الْكُتُبَ.","na3am, fa2anaa aktubu fiihi, wa2aqra2u fiihi alkutuba.","Yes, I write on it and read books on it."],["محمد","وَمَاذَا أَيْضًا؟","wamaadhaa ayDan?","What else?"],["صالح","أُرْسِلُ مِنْهُ.","ursilu minhu.","I send from it."],["محمد","مَاذَا تُرْسِلُ؟","maadhaa tursilu?","What do you send?"],["صالح","أُرْسِلُ الرَّسَائِلَ بِالشَّبَكَةِ.","ursilu ar-rasaa2ila bish-shabakati.","I send messages over the internet."],["محمد","وَتَسْتَقْبِلُهَا أَيْضًا؟","watastaqbiluhaa ayDan?","And you receive them too?"],["صالح","نَعَمْ، وَأَلْعَبُ فِيهِ.","na3am, wa2al3abu fiihi.","Yes, and I play on it."],["محمد","وَنَحْنُ فِي فَصْلِنَا لِكُلِّ طَالِبٍ حَاسُوبٌ.","wana7nu fii faSlinaa likulli Taalibin 7aasuubun.","In our class every student has a computer."],["صالح","هَذَا جَيِّدٌ.","hadhaa jayyidun.","That's good."]],["التهنئة: مُبَارَكٌ عَلَيْكَ ← بَارَكَ اللَّهُ فِيكَ. يُرْسِلُ ≠ يَسْتَقْبِلُ. «لِكُلِّ طَالِبٍ حَاسُوبٌ» = كل طالب عنده.","mubaarakun 3alayk → baaraka llaahu fiik. yursilu ≠ yastaqbilu. li-kulli Taalib = every student has."]],["كُرَتِي","⚽",[["الرِّيَاضَةُ","ar-riyaaDatu","sport","🏅"],["كُرَةُ الْقَدَمِ","kuratu alqadami","football","⚽"],["كُرَةُ السَّلَّةِ","kuratu as-sallati","basketball","🏀"],["كُرَةُ الطَّاوِلَةِ","kuratu aT-Taawilati","table tennis","🏓"],["الْكُرَةُ الطَّائِرَةُ","alkuratu aT-Taa2iratu","volleyball","🏐"],["فَرِيقٌ","fariiqun","team","👥"],["مُبَارَاةٌ","mubaaraatun","match","🏟️"],["السِّبَاحَةُ","as-sibaa7atu","swimming","🏊"],["الْأَلْعَابُ الْإِلِكْتُرُونِيَّةُ","al-al3aabu al-ilikturuuniyyatu","video games","🎮"],["قَلِيلٌ","qaliilun","few","🤏"]],[["معاوية","مَا هَذِهِ الْكُرَةُ؟","maa hadhihi alkuratu?","What's this ball?"],["محمد","هَذِهِ كُرَةُ السَّلَّةِ.","hadhihi kuratu as-sallati.","It's a basketball."],["معاوية","هُنَاكَ مُبَارَاةٌ فِي كُرَةِ الْقَدَمِ.","hunaaka mubaaraatun fii kurati alqadami.","There's a football match."],["محمد","مَتَى؟","mataa?","When?"],["معاوية","بَعْدَ الْعَصْرِ، هَلْ تَلْعَبُ مَعَنَا؟","ba3da al3aSri, hal tal3abu ma3anaa?","After Asr. Will you play with us?"],["محمد","لَا، أَنَا أُحِبُّ كُرَةَ السَّلَّةِ.","laa, anaa u7ibbu kurata as-sallati.","No, I like basketball."],["معاوية","وَمَاذَا تُحِبُّ مِنَ الرِّيَاضَةِ أَيْضًا؟","wamaadhaa tu7ibbu mina ar-riyaaDati ayDan?","What other sports do you like?"],["محمد","أُحِبُّ الْكُرَةَ الطَّائِرَةَ.","u7ibbu alkurata aT-Taa2irata.","I like volleyball."],["معاوية","أَنَا أُحِبُّ كُرَةَ الطَّاوِلَةِ.","anaa u7ibbu kurata aT-Taawilati.","I like table tennis."],["محمد","وَمَاذَا تُحِبُّ أَيْضًا؟","wamaadhaa tu7ibbu ayDan?","What else do you like?"],["معاوية","أُحِبُّ السِّبَاحَةَ، وَأُحِبُّ كُرَةَ الْقَدَمِ.","u7ibbu as-sibaa7ata, wa2u7ibbu kurata alqadami.","I like swimming, and football."],["محمد","هَلْ تُحِبُّ الْأَلْعَابَ الْإِلِكْتُرُونِيَّةَ؟","hal tu7ibbu al-al3aaba al-ilikturuuniyyata?","Do you like video games?"],["معاوية","أَنَا لَا أُحِبُّهَا.","anaa laa u7ibbuhaa.","I don't like them."],["محمد","وَأَنَا أُحِبُّ كُرَةَ الطَّاوِلَةِ، فَرِيقُهَا قَلِيلٌ.","wa2anaa u7ibbu kurata aT-Taawilati, fariiquhaa qaliilun.","And I like table tennis — its team is small."]],["«أُحِبُّ» و«لَا أُحِبُّ». الإضافة في أسماء الألعاب: كُرَةُ الْقَدَمِ، كُرَةُ السَّلَّةِ — والصفة: الْكُرَةُ الطَّائِرَةُ.","uHibbu / laa uHibbu. Idaafa: kuratu l-qadam; adjective: al-kuratu T-Taa2ira."]],["فُصُولُ السَّنَةِ","🍂",[["فُصُولُ السَّنَةِ","fuSuulu as-sanati","seasons","🗓️"],["فَصْلُ الصَّيْفِ","faSlu aS-Sayfi","summer","☀️"],["فَصْلُ الْخَرِيفِ","faSlu alkhariifi","autumn","🍂"],["فَصْلُ الشِّتَاءِ","faSlu ash-shitaa2i","winter","❄️"],["فَصْلُ الرَّبِيعِ","faSlu ar-rabii3i","spring","🌸"],["جَوٌّ","jawwun","weather","🌤️"],["تَرْتَفِعُ","tartafi3u","rises","📈"],["تَنْخَفِضُ","tankhafiDu","falls","📉"],["بَارِدٌ","baaridun","cold","🥶"],["دَافِئٌ","daafi2un","warm","🌡️"],["حَارٌّ","7aarrun","hot","🥵"],["تَقْرِيبًا","taqriiban","about","≈"]],[["محمد","دَرَسْنَا الْجَوَّ.","darasnaa aljawwa.","We studied the weather."],["معاوية","وَمَاذَا دَرَسْتُمْ أَيْضًا؟","wamaadhaa darastum ayDan?","What else did you study?"],["محمد","دَرَسْنَا فُصُولَ السَّنَةِ الثَّلَاثَةَ.","darasnaa fuSuula as-sanati ath-thalaathata.","We studied the three seasons."],["معاوية","هِيَ أَرْبَعَةٌ!","hiya arba3atun!","There are four!"],["محمد","لَا، ثَلَاثَةٌ.","laa, thalaathatun.","No, three."],["معاوية","مَا هِيَ؟","maa hiya?","What are they?"],["محمد","فَصْلُ الرَّبِيعِ، وَفَصْلُ الصَّيْفِ، وَفَصْلُ الْخَرِيفِ.","faSlu ar-rabii3i, wafaSlu aS-Sayfi, wafaSlu alkhariifi.","Spring, summer and autumn."],["معاوية","بَقِيَ فَصْلُ الشِّتَاءِ!","baqiya faSlu ash-shitaa2i!","Winter is missing!"],["محمد","أَنَا لَا أُحِبُّهُ، لِأَنَّهُ فَصْلٌ بَارِدٌ.","anaa laa u7ibbuhu, li2annahu faSlun baaridun.","I don't like it because it's cold."],["معاوية","الشِّتَاءُ فِي مَدِينَتِي دَافِئٌ تَقْرِيبًا.","ash-shitaa2u fii madiinatii daafi2un taqriiban.","Winter in my city is fairly warm."],["محمد","هَذَا جَيِّدٌ.","hadhaa jayyidun.","That's good."],["معاوية","وَفِي الصَّيْفِ الْجَوُّ حَارٌّ، وَالْمَطَرُ كَثِيرٌ.","wafii aS-Sayfi aljawwu 7aarrun, wal-maTaru kathiirun.","In summer it's hot, with lots of rain."],["محمد","وَفِي الصَّيْفِ تَرْتَفِعُ الْحَرَارَةُ، وَفِي الشِّتَاءِ تَنْخَفِضُ.","wafii aS-Sayfi tartafi3u al7araaratu, wafii ash-shitaa2i tankhafiDu.","In summer the temperature rises, and in winter it falls."]],["«لِأَنَّ» للسبب: لَا أُحِبُّهُ لِأَنَّهُ بَارِدٌ. «دَرَسْنَا» (إحنا) و«دَرَسْتُمْ» (إنتم). تَرْتَفِعُ ≠ تَنْخَفِضُ.","li-anna = because. darasnaa (we) / darastum (you pl.). tartafi3u ≠ tankhafiDu."]],["الْجَوُّ","⛅",[["مُشْمِسٌ","mushmisun","sunny","☀️"],["غَائِمٌ","ghaa2imun","cloudy","☁️"],["دَرَجَةُ الْحَرَارَةِ","darajatu al7araarati","temperature","🌡️"],["صِفْرٌ","Sifrun","zero","0️⃣"],["رِيَاحٌ","riyaa7un","winds","🌬️"],["شَدِيدَةٌ","shadiidatun","strong","💪"],["ثَلْجٌ","thaljun","snow","❄️"],["سَمَاءٌ","samaa2un","sky","🌌"],["مُمْطِرَةٌ","mumTiratun","rainy","🌧️"],["أَرْضٌ","arDun","ground","🟫"]],[["معاوية","كَانَ الْجَوُّ مُشْمِسًا.","kaana aljawwu mushmisan.","The weather was sunny."],["محمد","وَالْآنَ الْجَوُّ غَائِمٌ.","wal-2aana aljawwu ghaa2imun.","And now it's cloudy."],["معاوية","وَكَمْ دَرَجَةُ الْحَرَارَةِ؟","wakam darajatu al7araarati?","And what's the temperature?"],["محمد","تَحْتَ الصِّفْرِ.","ta7ta aS-Sifri.","Below zero."],["معاوية","هَلْ هُنَاكَ رِيَاحٌ؟","hal hunaaka riyaa7un?","Is it windy?"],["محمد","رِيَاحٌ شَدِيدَةٌ.","riyaa7un shadiidatun.","Strong winds."],["معاوية","لَا تَخَفْ، نَحْنُ فِي الْأَرْضِ.","laa takhaf, na7nu fii al-arDi.","Don't worry, we're on the ground."],["محمد","نَزَلَ الثَّلْجُ يَا مُعَاوِيَةُ.","nazala ath-thalju yaa mu3aawiyatu.","It's snowing, Mu'awiya."],["معاوية","لَا تَخَفْ.","laa takhaf.","Don't be afraid."],["محمد","السَّمَاءُ مُمْطِرَةٌ.","as-samaa2u mumTiratun.","The sky is rainy."],["معاوية","لَا تَخَفْ.","laa takhaf.","Don't be afraid."]],["«كَانَ» + الخبر منصوب: كَانَ الْجَوُّ مُشْمِسًا ← الْآنَ الْجَوُّ غَائِمٌ. أوصاف الجو: مُشْمِسٌ، غَائِمٌ، مُمْطِرٌ.","kaana + accusative: kaana l-jawwu mushmisan. Weather: mushmis, ghaa2im, mumTir."]],["الطَّالِبُ الْكَسُولُ","📉",[["نَتِيجَةٌ","natiijatun","result","📋"],["لَا بُدَّ","laa budda","must","❗"],["كَسُولٌ","kasuulun","lazy","😴"],["يَحْضُرُ","ya7Duru","attends","🙋"],["ضَعِيفَةٌ","Da3iifatun","weak","📉"],["يُذَاكِرُ","yudhaakiru","studies / revises","📚"],["نَادِرًا","naadiran","rarely","▫️"],["أَحْيَانًا","a7yaanan","sometimes","◽"],["غَالِبًا","ghaaliban","usually","◻️"],["دَائِمًا","daa2iman","always","⬜"],["يَفْهَمُ","yafhamu","understands","💡"],["لَكِنْ","lakin","but","↔️"]],[["عيسى","كَيْفَ نَتِيجَتِي يَا أُسْتَاذُ؟","kayfa natiijatii yaa ustaadhu?","How is my result, teacher?"],["عقيل","نَتِيجَتُكَ ضَعِيفَةٌ.","natiijatuka Da3iifatun.","Your result is weak."],["عيسى","لِمَاذَا يَا أُسْتَاذُ؟","limaadhaa yaa ustaadhu?","Why, teacher?"],["عقيل","أَنْتَ كَسُولٌ.","anta kasuulun.","You're lazy."],["عيسى","كَيْفَ؟","kayfa?","How?"],["عقيل","تَحْضُرُ إِلَى الْمَدْرَسَةِ قَلِيلًا، وَتَغِيبُ كَثِيرًا.","ta7Duru ilaa almadrasati qaliilan, wataghiibu kathiiran.","You come to school little and miss a lot."],["عيسى","صَحِيحٌ.","Sa7ii7un.","True."],["عقيل","تَلْعَبُ غَالِبًا، وَتُذَاكِرُ نَادِرًا.","tal3abu ghaaliban, watudhaakiru naadiran.","You usually play and rarely revise."],["عيسى","صَحِيحٌ، لَكِنِّي أَفْهَمُ أَحْيَانًا.","Sa7ii7un, lakinnii afhamu a7yaanan.","True, but I understand sometimes."],["عقيل","لَا يَكْفِي، لَا بُدَّ أَنْ تَفْهَمَ دَائِمًا.","laa yakfii, laa budda an tafhama daa2iman.","That's not enough — you must always understand."]],["كلمات التكرار: نَادِرًا < أَحْيَانًا < غَالِبًا < دَائِمًا. «لَا بُدَّ أَنْ» = لازم. «لَكِنْ» للاستدراك.","Frequency: naadiran < aHyaanan < ghaaliban < daa2iman. laa budda an = must. laakin = but."]],["الْعُطْلَةُ","🏖️",[["عُطْلَةٌ","3uTlatun","holiday","🏖️"],["دِرَاسَةٌ","diraasatun","study","📚"],["مُسْتَحِيلٌ","musta7iilun","impossible","🚫"],["عُطْلَةُ الصَّيْفِ","3uTlatu aS-Sayfi","summer holiday","☀️"],["أَشْهُرٌ","ashhurun","months","🗓️"],["عُطْلَةُ الْأُسْبُوعِ","3uTlatu al-usbuu3i","weekend","📅"],["عُطْلَةُ الشِّتَاءِ","3uTlatu ash-shitaa2i","winter holiday","❄️"],["عُطْلَةُ الرَّبِيعِ","3uTlatu ar-rabii3i","spring holiday","🌸"],["يُمْكِنُ","yumkinu","is possible","✅"],["يَبْدَأُ","yabda2u","starts","▶️"],["يَحْفَظُ","ya7faZu","memorises","🧠"],["يَسْأَلُ","yas2alu","asks","❓"]],[["صالح","مَتَى الْعُطْلَةُ؟","mataa al3uTlatu?","When is the holiday?"],["محمد","هَذَا أَوَّلُ يَوْمٍ فِي الدِّرَاسَةِ!","hadhaa awwalu yawmin fii ad-diraasati!","This is the first day of school!"],["صالح","مَتَى الْعُطْلَةُ؟","mataa al3uTlatu?","When is the holiday?"],["محمد","عُطْلَةُ الْأُسْبُوعِ بَعْدَ خَمْسَةِ أَيَّامٍ.","3uTlatu al-usbuu3i ba3da khamsati ayyaamin.","The weekend is in five days."],["صالح","مَتَى عُطْلَةُ الصَّيْفِ؟","mataa 3uTlatu aS-Sayfi?","When is the summer holiday?"],["محمد","بَعْدَ تِسْعَةِ أَشْهُرٍ.","ba3da tis3ati ashhurin.","In nine months."],["صالح","هَلْ هُنَاكَ عُطْلَةٌ أُخْرَى؟","hal hunaaka 3uTlatun ukhraa?","Is there another holiday?"],["محمد","نَعَمْ، عُطْلَةُ الشِّتَاءِ.","na3am, 3uTlatu ash-shitaa2i.","Yes, the winter holiday."],["صالح","هَلْ هُنَاكَ عُطْلَةٌ أُخْرَى؟","hal hunaaka 3uTlatun ukhraa?","Another one?"],["محمد","نَعَمْ، عُطْلَةُ الرَّبِيعِ.","na3am, 3uTlatu ar-rabii3i.","Yes, the spring holiday."],["صالح","هَلْ يُمْكِنُ أَنْ تَبْدَأَ كُلُّهَا غَدًا؟","hal yumkinu an tabda2a kulluhaa ghadan?","Could they all start tomorrow?"],["محمد","مُسْتَحِيلٌ، لَكِنْ لِمَاذَا تَسْأَلُ عَنِ الْعُطْلَةِ؟","musta7iilun, lakin limaadhaa tas2alu 3ani al3uTlati?","Impossible! But why do you ask about the holiday?"],["صالح","سَأَحْفَظُ الْقُرْآنَ فِي الْعُطْلَةِ.","sa2a7faZu alqur2aana fii al3uTlati.","I'll memorise the Qur'an in the holiday."]],["«هَلْ يُمْكِنُ أَنْ…؟» للسؤال عن الإمكان ← مُسْتَحِيلٌ / يُمْكِنُ. «أُخْرَى» مؤنث «آخَرُ».","hal yumkinu an …? = is it possible? → mustaHiil. ukhraa = another (f.)."]]]