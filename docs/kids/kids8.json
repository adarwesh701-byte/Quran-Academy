[["الْإِجَازَةُ الْأُسْبُوعِيَّةُ","🏡",[["أُسْرَةٌ","usratun","family","👨‍👩‍👧‍👦"],["مُشْتَرَيَاتٌ","mushtarayaatun","shopping","🛒"],["يُرَتِّبُ","yurattibu","tidies","🧺"],["يُنَظِّفُ","yunaZZifu","cleans","🧽"],["يَكْوِي","yakwii","irons","👔"],["نُزْهَةٌ","nuzhatun","outing","🧺"],["رَأْيٌ","ra2ayun","opinion","💭"],["مُوَافِقُونَ","muwaafiquuna","agreed","🤝"],["يُشَارِكُ","yushaariku","takes part","🙌"],["إِجَازَةٌ","ijaazatun","holiday / day off","🏖️"]],[["قاسم","لَا بُدَّ أَنْ تُشَارِكَ الْأُسْرَةُ كُلُّهَا فِي الْعَمَلِ الْيَوْمَ.","laa budda an tushaarika al-usratu kulluhaa fii al3amali alyawma.","The whole family must help with the work today."],["فاطمة","نَعَمْ، فَالْيَوْمُ هُوَ الْإِجَازَةُ الْأُسْبُوعِيَّةُ.","na3am, fal-yawmu huwa al-ijaazatu al-usbuu3iyyatu.","Yes, today is the weekly day off."],["قاسم","أَنَا سَأُحْضِرُ الْمُشْتَرَيَاتِ الْأُسْبُوعِيَّةَ.","anaa sa2u7Diru almushtarayaati al-usbuu3iyyata.","I'll get the weekly shopping."],["فاطمة","وَأَنَا سَأَغْسِلُ الْمَلَابِسَ وَأَكْوِيهَا.","wa2anaa sa2aghsilu almalaabisa wa2akwiihaa.","And I'll wash and iron the clothes."],["خولة","وَأَنَا سَأُرَتِّبُ الْبَيْتَ.","wa2anaa sa2urattibu albayta.","And I'll tidy the house."],["محمد","وَأَنَا سَأُنَظِّفُ السَّيَّارَةَ.","wa2anaa sa2unaZZifu as-sayyaarata.","And I'll clean the car."],["قاسم","مَا رَأْيُكُمْ أَنْ نَخْرُجَ لِلنُّزْهَةِ بَعْدَ ذَلِكَ؟","maa ra2ayukum an nakhruja lilnnuzhati ba3da dhalika?","What do you think about going on an outing after that?"],["الجميع","مُوَافِقُونَ!","muwaafiquuna!","Agreed!"]],["«سَـ» للمستقبل مع كل الضمائر: سَأُحْضِرُ، سَأَغْسِلُ، سَأُرَتِّبُ. «مَا رَأْيُكُمْ أَنْ…؟» للاقتراح.","sa- = will: sa-uHDiru, sa-aghsilu. maa ra2yukum an …? = how about …?"]],["الرِّحْلَةُ","🚌",[["يُعِدُّ","yu3iddu","prepares","📝"],["رِحْلَةٌ","ri7latun","trip","🚌"],["بَرِّيَّةٌ","barriyyatun","by land","🏜️"],["تَسْجِيلٌ","tasjiilun","registration","📝"],["خِلَالَ","khilaala","during","⏳"],["رُسُومٌ","rusuumun","fees","💵"],["مُدَّةٌ","muddatun","duration","⏱️"],["بَحْرٌ","ba7run","sea","🌊"],["نَهْرٌ","nahrun","river","🏞️"],["شَاطِئٌ","shaaTi2un","beach","🏖️"],["وَجْبَةٌ","wajbatun","meal","🍱"],["دِينَارٌ","diinaarun","dinar","🪙"],["خَرِيطَةٌ","khariiTatun","map","🗺️"]],[["معاوية","مَاذَا أَعَدَّتِ الْمَدْرَسَةُ هَذَا الْعَامَ؟","maadhaa a3addati almadrasatu hadhaa al3aama?","What has the school prepared this year?"],["محمد","أَعَدَّتْ رِحْلَةً بَرِّيَّةً.","a3addat ri7latan barriyyatan.","It's prepared a land trip."],["معاوية","مَتَى التَّسْجِيلُ؟","mataa at-tasjiilu?","When is registration?"],["محمد","خِلَالَ هَذَا الشَّهْرِ.","khilaala hadhaa ash-shahri.","During this month."],["معاوية","كَمْ رُسُومُ التَّسْجِيلِ؟","kam rusuumu at-tasjiili?","How much is the fee?"],["محمد","عِشْرُونَ دِينَارًا.","3ishruuna diinaaran.","Twenty dinars."],["معاوية","كَمْ مُدَّةُ الرِّحْلَةِ؟","kam muddatu ar-ri7lati?","How long is the trip?"],["محمد","نِصْفُ يَوْمٍ، وَيُوجَدُ وَجْبَةُ غَدَاءٍ.","niSfu yawmin, wayuujadu wajbatu ghadaa2in.","Half a day, and there's lunch."],["معاوية","وَهَلْ سَنَرَى الْبَحْرَ وَالنَّهْرَ؟","wahal sanaraa alba7ra wan-nahra?","Will we see the sea and the river?"],["محمد","لَا، تَرَاهُمَا فِي الْخَرِيطَةِ.","laa, taraahumaa fii alkhariiTati.","No — you'll see them on the map."],["معاوية","أُحِبُّ الشَّاطِئَ.","u7ibbu ash-shaaTi2a.","I love the beach."]],["«كَمْ» + اسم مفرد منصوب: كَمْ دِينَارًا؟ والسؤال عن المدة: كَمْ مُدَّةُ…؟ «تَرَاهُمَا» = تشوفهم (اتنين).","kam + singular: kam diinaaran? taraahumaa = you see the two of them."]],["بَيْتُنَا الْجَمِيلُ","📐",[["مُثَلَّثٌ","muthallathun","triangle","🔺"],["دَائِرَةٌ","daa2iratun","circle","⭕"],["مُرَبَّعٌ","murabba3un","square","🟥"],["مُسْتَطِيلٌ","mustaTiilun","rectangle","▬"],["خَطٌّ","khaTTun","line","➖"],["نُقْطَةٌ","nuqTatun","dot","•"],["تَصْمِيمٌ","taSmiimun","design","📐"],["مُصَمِّمٌ","muSammimun","designer","👷"],["يَتَّصِلُ","yattaSilu","calls","📞"],["أَفْكَارٌ","afkaarun","ideas","💡"],["أَلْفٌ","alfun","thousand","1️⃣0️⃣0️⃣0️⃣"],["بِكَمْ","bikam","for how much","💰"]],[["محمد","شُكْرًا يَا أَبِي عَلَى هَذَا الْبَيْتِ الْجَمِيلِ.","shukran yaa abii 3alaa hadhaa albayti aljamiili.","Thank you, Dad, for this beautiful house."],["قاسم","عَفْوًا يَا وَلَدِي.","3afwan yaa waladii.","You're welcome, my son."],["محمد","أَعْجَبَتْنِي النَّافِذَةُ.","a3jabatnii an-naafidhatu.","I liked the window."],["قاسم","لِمَاذَا؟","limaadhaa?","Why?"],["محمد","مُثَلَّثٌ كَبِيرٌ، وَفِي الْمُثَلَّثِ دَائِرَةٌ.","muthallathun kabiirun, wafii almuthallathi daa2iratun.","A big triangle, with a circle inside it."],["قاسم","هَذِهِ مِنْ أَفْكَارِ عَبُّودٍ.","hadhihi min afkaari 3abbuudin.","This is one of Abboud's ideas."],["محمد","مَنْ عَبُّودٌ؟","man 3abbuudun?","Who's Abboud?"],["قاسم","مُصَمِّمُ الْبَيْتِ.","muSammimu albayti.","The house's designer."],["محمد","أَفْكَارٌ جَمِيلَةٌ.","afkaarun jamiilatun.","Beautiful ideas."],["قاسم","كَانَ الْبَابُ مُرَبَّعًا، فَصَارَ مُسْتَطِيلًا.","kaana albaabu murabba3an, faSaara mustaTiilan.","The door was square, then became a rectangle."],["محمد","وَمَا هَذَا الْخَطُّ؟ وَمَا هَذِهِ النُّقْطَةُ؟","wamaa hadhaa alkhaTTu? wamaa hadhihi an-nuqTatu?","And what's this line? And this dot?"],["قاسم","لَا أَدْرِي، سَأَسْأَلُ الْمُصَمِّمَ.","laa adrii, sa2as2alu almuSammima.","I don't know — I'll ask the designer."],["محمد","بِكَمْ تَصْمِيمُ الْبَيْتِ؟","bikam taSmiimu albayti?","How much did the design cost?"],["قاسم","بِأَلْفِ رِيَالٍ.","bi2alfi riyaalin.","A thousand riyals."],["محمد","اتَّصِلْ بِهِ يَا أَبِي، وَقُلْ لَهُ شُكْرًا.","ittaSil bihi yaa abii, waqul lahu shukran.","Call him, Dad, and say thank you."],["قاسم","حَسَنًا.","7asanan.","Okay."]],["«كَانَ … فَصَارَ …» للتغيير. «بِكَمْ؟» للسعر. الأشكال: مُثَلَّثٌ، مُرَبَّعٌ، مُسْتَطِيلٌ، دَائِرَةٌ.","kaana … fa-Saara … = was … then became. bikam? = for how much? Shapes: muthallath, murabba3, mustaTiil, daa2ira."]],["الْهَاتِفُ","📞",[["رَقْمٌ","raqmun","number","🔢"],["هَاتِفٌ","haatifun","phone","📞"],["الْهَاتِفُ الثَّابِتُ","alhaatifu ath-thaabitu","landline","☎️"],["خَلَوِيٌّ","khalawiyyun","mobile","📱"],["يَرُدُّ","yaruddu","answers","🗨️"],["مَشْغُولٌ","mashghuulun","busy","⛔"],["مُشْكِلَةٌ","mushkilatun","problem","⚠️"],["طَبِيبٌ","Tabiibun","doctor","🧑‍⚕️"],["قَلْبٌ","qalbun","heart","❤️"],["ضَغْطٌ","DaghTun","blood pressure","🩺"],["يَفْحَصُ","yaf7aSu","examines","🔬"],["يَقِيسُ","yaqiisu","measures","📏"],["أَبْشِرْ","abshir","sure thing","👌"],["حَالًا","7aalan","right away","⚡"]],[["عمار","اتَّصِلْ بِالطَّبِيبِ عُمَرَ مِنْ فَضْلِكَ.","ittaSil biT-Tabiibi 3umara min faDlika.","Call Dr Umar, please."],["صالح","أَعَلَى الْهَاتِفِ الثَّابِتِ؟","a3alaa alhaatifi ath-thaabiti?","On the landline?"],["عمار","نَعَمْ.","na3am.","Yes."],["صالح","حَاضِرٌ، أَعْرِفُ الرَّقْمَ.","7aaDirun, a3rifu ar-raqma.","Sure, I know the number."],["عمار","جَيِّدٌ.","jayyidun.","Good."],["صالح","هَذِهِ مُشْكِلَةٌ، عُمَرُ لَا يَرُدُّ.","hadhihi mushkilatun, 3umaru laa yaruddu.","Problem — Umar isn't answering."],["عمار","اتَّصِلْ عَلَى الْهَاتِفِ الْخَلَوِيِّ.","ittaSil 3alaa alhaatifi alkhalawiyyi.","Call his mobile."],["صالح","أَعْرِفُ الرَّقْمَ.","a3rifu ar-raqma.","I know the number."],["عمار","هَلْ رَدَّ عُمَرُ؟","hal radda 3umaru?","Did Umar answer?"],["صالح","لَا، الْهَاتِفُ مَشْغُولٌ.","laa, alhaatifu mashghuulun.","No, the line is busy."],["عمار","اكْتُبْ لِلطَّبِيبِ: أُرِيدُ أَنْ تَفْحَصَ قَلْبِي، وَتَقِيسَ ضَغْطِي.","iktub lilTTabiibi uriidu an taf7aSa qalbii, wataqiisa DaghTii.","Write to the doctor: I want you to check my heart and measure my blood pressure."],["صالح","أَبْشِرْ، سَأَكْتُبُ حَالًا.","abshir, sa2aktubu 7aalan.","Sure, I'll write right away."]],["«مِنْ فَضْلِكَ» للطلب بأدب. «أُرِيدُ أَنْ» + مضارع منصوب: أَنْ تَفْحَصَ، أَنْ تَقِيسَ.","min faDlika = please. uriidu an + subjunctive: an tafHaSa."]],["فِي الْإِسْلَامِ عِيدَانِ","🎉",[["عِيدٌ","3iidun","Eid","🎉"],["عِيدَانِ","3iidaani","two Eids","2️⃣"],["عِيدُ الْأَضْحَى","3iidu al-aD7aa","Eid al-Adha","🐑"],["عِيدُ الْفِطْرِ","3iidu alfiTri","Eid al-Fitr","🌙"],["الْإِسْلَامُ","al-islaamu","Islam","☪️"],["أُضْحِيَةٌ","uD7iyatun","sacrifice","🐑"],["حَقًّا","7aqqan","really","❗"],["زَكَاةُ الْفِطْرِ","zakaatu alfiTri","zakat al-fitr","🌾"],["صِيَامٌ","Siyaamun","fasting","🌙"],["لَا يَجُوزُ","laa yajuuzu","not allowed","🚫"],["يَذْبَحُ","yadhba7u","slaughters","🔪"],["يُخْرِجُ","yukhriju","gives out","🤲"],["فَرْقٌ","farqun","difference","↔️"]],[["فاطمة","غَدًا عِيدُ الْفِطْرِ.","ghadan 3iidu alfiTri.","Tomorrow is Eid al-Fitr."],["خولة","أَحَقًّا؟","a7aqqan?","Really?"],["فاطمة","نَعَمْ، الْبَسِي مَلَابِسَ الْعِيدِ يَا خَوْلَةُ.","na3am, albasii malaabisa al3iidi yaa khawlatu.","Yes, put on your Eid clothes, Khawla."],["خولة","وَمَتَى عِيدُ الْأَضْحَى يَا أُمِّي؟","wamataa 3iidu al-aD7aa yaa ummii?","And when is Eid al-Adha, Mum?"],["فاطمة","فِي الْعَاشِرِ مِنْ شَهْرِ ذِي الْحِجَّةِ.","fii al3aashiri min shahri dhii al7ijjati.","On the tenth of Dhul-Hijjah."],["خولة","مَا الْفَرْقُ بَيْنَ عِيدِ الْفِطْرِ وَعِيدِ الْأَضْحَى؟","maa alfarqu bayna 3iidi alfiTri wa3iidi al-aD7aa?","What's the difference between the two Eids?"],["فاطمة","فِي عِيدِ الْفِطْرِ نُخْرِجُ زَكَاةَ الْفِطْرِ.","fii 3iidi alfiTri nukhriju zakaata alfiTri.","On Eid al-Fitr we give zakat al-fitr."],["خولة","وَمَاذَا فِي عِيدِ الْأَضْحَى؟","wamaadhaa fii 3iidi al-aD7aa?","And on Eid al-Adha?"],["فاطمة","هُوَ عِيدُ الْأُضْحِيَةِ.","huwa 3iidu al-uD7iyati.","It's the Eid of the sacrifice."],["خولة","كَيْفَ؟","kayfa?","How?"],["فاطمة","نَذْبَحُ فِيهِ الْأُضْحِيَةَ.","nadhba7u fiihi al-uD7iyata.","We slaughter the sacrifice on it."],["خولة","هَلْ فِي الْإِسْلَامِ غَيْرُهُمَا؟","hal fii al-islaami ghayruhumaa?","Are there others in Islam?"],["فاطمة","فِي الْإِسْلَامِ عِيدَانِ فَقَطْ.","fii al-islaami 3iidaani faqaT.","Islam has only two Eids."],["خولة","وَهَلْ نَصُومُ يَوْمَ الْعِيدِ؟","wahal naSuumu yawma al3iidi?","Do we fast on Eid?"],["فاطمة","لَا، لَا يَجُوزُ صِيَامُهُ.","laa, laa yajuuzu Siyaamuhu.","No, fasting on it isn't allowed."]],["المثنى: عِيدٌ ← عِيدَانِ. «مَا الْفَرْقُ بَيْنَ … وَ…؟». «لَا يَجُوزُ» = ممنوع شرعًا.","Dual: 3iid → 3iidaani. maa l-farqu bayna … wa …? laa yajuuzu = not permitted."]],["مَنْ دَرَسَ نَجَحَ","🎓",[["يَرْسُبُ","yarsubu","fails","❌"],["يَنْجَحُ","yanja7u","passes","✅"],["يَبْذُلُ","yabdhulu","makes (effort)","💪"],["يَدْعُو","yad3uu","prays for","🤲"],["يُهْمِلُ","yuhmilu","neglects","😴"],["يَتْعَبُ","yat3abu","works hard","😓"],["وَفَّقَكَ اللَّهُ","waffaqaka allaahu","may Allah grant you success","🤲"],["جُهْدٌ","juhdun","effort","🏋️"],["اخْتِبَارَاتٌ","ikhtibaaraatun","exams","📝"],["لَوْ سَمَحْتَ","law sama7ta","please","🙏"]],[["فضل","أَدْرُسُ خَمْسَ سَاعَاتٍ فِي الْيَوْمِ يَا أَبِي.","adrusu khamsa saa3aatin fii alyawmi yaa abii.","I study five hours a day, Dad."],["حبيب","هَذَا جُهْدٌ كَبِيرٌ يَا فَضْلُ.","hadhaa juhdun kabiirun yaa faDlu.","That's a big effort, Fadl."],["فضل","الِاخْتِبَارَاتُ قَرِيبَةٌ يَا أَبِي.","aliakhtibaaraatu qariibatun yaa abii.","The exams are close, Dad."],["حبيب","مَتَى أَوَّلُ اخْتِبَارٍ؟","mataa awwalu ikhtibaarin?","When's the first exam?"],["فضل","بَعْدَ أُسْبُوعٍ.","ba3da usbuu3in.","In a week."],["حبيب","وَفَّقَكَ اللَّهُ.","waffaqaka allaahu.","May Allah grant you success."],["فضل","لَا أُرِيدُ أَنْ أَرْسُبَ.","laa uriidu an arsuba.","I don't want to fail."],["حبيب","مَنْ دَرَسَ نَجَحَ.","man darasa naja7a.","Whoever studies, succeeds."],["فضل","سَأَبْذُلُ جُهْدِي يَا أَبِي.","sa2abdhulu juhdii yaa abii.","I'll do my best, Dad."],["حبيب","مَنْ يَتْعَبْ يَنْجَحْ، وَمَنْ يُهْمِلْ يَرْسُبْ.","man yat3ab yanja7, waman yuhmil yarsub.","Whoever works hard passes, and whoever neglects fails."],["فضل","ادْعُ لِي يَا أَبِي لَوْ سَمَحْتَ.","id3u lii yaa abii law sama7ta.","Pray for me, Dad, please."],["حبيب","وَفَّقَكَ اللَّهُ.","waffaqaka allaahu.","May Allah grant you success."]],["الشرط بـ«مَنْ»: مَنْ دَرَسَ نَجَحَ، مَنْ يَتْعَبْ يَنْجَحْ (الفعلين مجزومين). يَنْجَحُ ≠ يَرْسُبُ.","Conditional man: man darasa najaHa; man yat3ab yanjaH (jussive). yanjaHu ≠ yarsubu."]],["الْجَدْوَلُ الدِّرَاسِيُّ","🗓️",[["الْجَدْوَلُ الدِّرَاسِيُّ","aljadwalu ad-diraasiyyu","timetable","🗓️"],["فُسْحَةٌ","fus7atun","break","🍎"],["دُرُوسٌ","duruusun","lessons","📚"],["أَفْضَلُ","afDalu","best","🏆"],["انْصِرَافٌ","inSiraafun","dismissal","🏃"],["الطَّابُورُ الصَّبَاحِيُّ","aT-Taabuuru aS-Sabaa7iyyu","morning assembly","🧍"],["مَاضِيَةٌ","maaDiyatun","last / past","⏮️"],["رِيَاضِيَّاتٌ","riyaaDiyyaatun","maths","➗"],["رَجُلٌ","rajulun","man","🧔"]],[["محمد","هَلْ رَأَيْتَ الْجَدْوَلَ الدِّرَاسِيَّ يَا فَضْلُ؟","hal ra2ayta aljadwala ad-diraasiyya yaa faDlu?","Have you seen the timetable, Fadl?"],["فضل","لَا، هَلْ هُوَ جَيِّدٌ؟","laa, hal huwa jayyidun?","No — is it good?"],["محمد","نَعَمْ، جَيِّدٌ.","na3am, jayyidun.","Yes, good."],["فضل","كَمْ فُسْحَةً فِي الْيَوْمِ؟","kam fus7atan fii alyawmi?","How many breaks a day?"],["محمد","اسْأَلْ عَنِ الدُّرُوسِ أَفْضَلُ لَكَ يَا رَجُلُ.","is2al 3ani ad-duruusi afDalu laka yaa rajulu.","Better ask about the lessons, man."],["فضل","وَمَتَى الِانْصِرَافُ؟","wamataa alianSiraafu?","And when's home time?"],["محمد","الْوَاحِدَةُ ظُهْرًا.","alwaa7idatu Zuhran.","One in the afternoon."],["فضل","وَمَتَى الطَّابُورُ الصَّبَاحِيُّ؟","wamataa aT-Taabuuru aS-Sabaa7iyyu?","And when's morning assembly?"],["محمد","السَّابِعَةُ وَالرُّبُعُ صَبَاحًا.","as-saabi3atu war-rubu3u Sabaa7an.","Quarter past seven in the morning."],["فضل","فِي السَّنَةِ الْمَاضِيَةِ لَمْ أَنْجَحْ فِي الرِّيَاضِيَّاتِ.","fii as-sanati almaaDiyati lam anja7 fii ar-riyaaDiyyaati.","Last year I didn't pass maths."]],["الوقت: السَّابِعَةُ وَالرُّبُعُ، الْوَاحِدَةُ ظُهْرًا. «كَمْ» + مفرد منصوب: كَمْ فُسْحَةً؟ «أَفْضَلُ» للتفضيل.","Time: as-saabi3atu wa-r-rubu3 (7:15). kam fusHatan? afDalu = better/best."]],["الْعَمَلُ فِي الْمَزْرَعَةِ","🚜",[["ثِمَارٌ","thimaarun","fruits / crops","🍊"],["هَوَاءٌ","hawaa2un","air","🌬️"],["مُتْعِبٌ","mut3ibun","tiring","😓"],["لَيْتَ","layta","I wish","🌠"],["مَزْرَعَةٌ","mazra3atun","farm","🚜"],["مُمْتِعٌ","mumti3un","fun","😄"],["نَقِيٌّ","naqiyyun","pure / clean","💧"],["يُسَاعِدُ","yusaa3idu","helps","🤝"],["يُصْلِحُ","yuSli7u","repairs","🔧"],["يَبْذُرُ","yabdhuru","sows","🌱"],["يَقْطِفُ","yaqTifu","picks","🍎"],["يَسْقِي","yasqii","waters","🚿"]],[["صالح","مَاذَا عَمِلْتَ فِي الصَّيْفِ يَا مُحَمَّدُ؟","maadhaa 3amilta fii aS-Sayfi yaa mu7ammadu?","What did you do in the summer, Muhammad?"],["محمد","سَاعَدْتُ وَالِدِي فِي الْمَزْرَعَةِ.","saa3adtu waalidii fii almazra3ati.","I helped my father on the farm."],["صالح","الْهَوَاءُ فِي الْمَزْرَعَةِ نَقِيٌّ.","alhawaa2u fii almazra3ati naqiyyun.","The air on the farm is clean."],["محمد","سَقَيْتُ الْمَزْرَعَةَ مَعَهُ.","saqaytu almazra3ata ma3ahu.","I watered the farm with him."],["صالح","وَمَاذَا أَيْضًا؟","wamaadhaa ayDan?","What else?"],["محمد","وَقَطَفْتُ مَعَهُ.","waqaTaftu ma3ahu.","And I picked with him."],["صالح","وَمَاذَا قَطَفْتَ؟","wamaadhaa qaTafta?","What did you pick?"],["محمد","قَطَفْتُ الثِّمَارَ.","qaTaftu ath-thimaara.","I picked the fruit."],["صالح","وَمَاذَا أَيْضًا؟","wamaadhaa ayDan?","What else?"],["محمد","وَأَصْلَحْنَا الْمَزْرَعَةَ.","wa2aSla7naa almazra3ata.","And we fixed up the farm."],["صالح","لَيْتَنِي مَعَكَ لِأُسَاعِدَكَ.","laytanii ma3aka li2usaa3idaka.","I wish I'd been with you to help."],["محمد","الْعَمَلُ فِي الْمَزْرَعَةِ مُمْتِعٌ.","al3amalu fii almazra3ati mumti3un.","Farm work is fun."],["صالح","أَحَقًّا؟","a7aqqan?","Really?"],["محمد","نَعَمْ، نَبْذُرُ وَنَسْقِي، ثُمَّ نَقْطِفُ الثِّمَارَ.","na3am, nabdhuru wanasqii, thumma naqTifu ath-thimaara.","Yes: we sow and water, then pick the fruit."]],["«لَيْتَ» للتمني: لَيْتَنِي مَعَكَ. الماضي مع «أنا»: سَاعَدْتُ، سَقَيْتُ، قَطَفْتُ — ومع «إحنا»: أَصْلَحْنَا. مُمْتِعٌ ≠ مُتْعِبٌ.","layta = I wish: laytanii ma3ak. Past I: saa3adtu, saqaytu; we: aSlaHnaa. mumti3 ≠ mut3ib."]]]